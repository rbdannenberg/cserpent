# usage: serpent64 compiler.srp <src>.srp [-o <output-folder>] [-d] [-c]
#        [-release] [-debug]
# diff <(serpent64 compiler.srp benchmarks/srp/binary-trees.srp -o output) <(echo "exit()" | serpent64 benchmarks/srp/binary-trees.srp)

require "src/frontend/compile"
require "src/backend/codegen_visitor"
require "src/backend/semcheck_visitor"
require "cmdline"

require "utils"
load "debug"

# [-d]: debug flag, prints the AST
# <file-to-compile>.srp: the file to compile
# [-c]: compile flag, compiles the generated code

debug = false
compile = false
cmdline = Cmdline()
# parsing command line options
DEBUG = cmdline.get_option("-d")
COMPILE = cmdline.get_option("-c")
RELEASEBUILD = cmdline.get_option("-release")
DEBUGBUILD = cmdline.get_option("-debug")
output_folder = cmdline.get_named("-o", "output")
output_folder = file_change_suffix(output_folder, nil)
CONFIG = "Debug" if DEBUGBUILD else "Release"
original_target_file = cmdline.get_posn(1)
program_name = file_base(file_name_from_path(original_target_file))

if not original_target_file:
    print "Command line needs at least source path."
    print "Usage: serpent64 compiler [-d] [-c] [-release] [-debug] ";
    print     "[-o <output>] <src>.srp"
    print "    -d to print parse tree"
    print "    -c to compile and run the generated code"
    print "    -release to set CMAKE_BUILD_TYPE=Release"
    print "    -debug to set CMAKE_BUILD_TYPE=Debug"
    print "    -o <output> selects directory for compiler outputs"
    print "    <src>.srp is the root Serpent source file"
    print command_line_arguments
    exit()

if DEBUGBUILD and RELEASEBUILD:
    print "Error: both -release and -debug were specified on command line"
    exit(1)
if not DEBUGBUILD and not RELEASEBUILD:
    print "Using CMAKE_BUILD_TYPE=Release. Specify -debug for Debug."

// system("rm -r " + output_folder)
mkdir(output_folder)

session = CompilationSession()
res = session.load_main_file(original_target_file)
if isnull(res):
    print "ERROR reported compiling "; original_target_file

visitor = CodegenVisitor(output_folder)
pass = 8 # so an error isn't thrown for empty base class
cmake_files = []
for target_file in session.get_topological_ordering():
    var ast = session.files[target_file]

    if DEBUG:
        print "----- AST from", target_file, "-----"
        print_ast(ast)

    var target_filename = file_change_suffix(file_name_from_path(
                                                     target_file), nil)
    visitor.generate_code(target_filename, ast, session.deps[target_file])
    cmake_files.append(target_filename + ".cpp")
    cmake_files.append(target_filename + ".h")


main_file = open(output_folder + "/main.cpp", "w")
visitor.write_cs_header(main_file, nil)
for source_file in session.get_topological_ordering():
    main_file.write("int " + file_base(source_file) + "_main();\n")
main_file.write("\n\nint main()\n{\n")
main_file.write("    runtime_init();\n")
main_file.write("    cs_global_init();\n\n")
for source_file in session.get_topological_ordering():
    main_file.write("    " + file_base(source_file) + "_main();\n")
main_file.write("\n    return 0;\n}\n")
//main_file.write("\n\n// mark any global references to heap objects\n")
main_file.write("\nvoid gc_mark_roots()\n")
main_file.write("{\n}\n")
// main_file.write("void runtime_mark_roots();\n")
// main_file.write("{\n}\n")
main_file.close()


visitor.generate_globals()


if COMPILE:
    # write CMakeLists.txt
    output_folder = output_folder + "/"
    cmake_lists = open(output_folder + "CMakeLists.txt", "w")
    cmake_lists.write("cmake_minimum_required(VERSION 3.29)\n")
    cmake_lists.write("project(" + program_name + ")\n")
    cmake_lists.write("set(CMAKE_CXX_STANDARD 17)\n")
    cmake_lists.write("add_compile_options(-Wno-return-type -Wplacement-new=0" +
                      " -fno-strict-aliasing)\n")
    cmake_lists.write("set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)\n")
    cmake_lists.write("\n")
    cmake_lists.write("# normal set of include paths:\n")
    // cmake_lists.write("include_directories(\n")
    // wd = getcwd() # note this ends with "/"
    // runtime_directories = ["src/runtime", "src/runtime/data_structures", 
    //         "src/runtime/builtin_functions", "src/gc", "src/runtime/globals"]
    // for include_path in runtime_directories:
    //     cmake_lists.write("        " + wd + include_path + "\n")
    // cmake_lists.write(")\n")
    // cmake_lists.write("find_library(RUNTIME_LIB_PATH NAMES libruntime.a\n")
    // cmake_lists.write("        PATHS " + wd + "/Release " + wd + "/Debug " +
    //                   wd + "/cmake-build-release\n")
    // cmake_lists.write("        DOC \"cserpent runtime library\")\n")
    // cmake_lists.write("set(RUNTIME_LIB_PATH \"" + wd +
    //                   "cmake-build-release/libruntime.a\")\n")
    cmake_lists.write("# runtime library\n")
    cmake_lists.write("add_subdirectory(../src/runtime build)\n")

    cmake_lists.write("add_executable(" + program_name + "\n")
    for file in cmake_files:
        cmake_lists.write("        " + file + "\n")
    cmake_lists.write("        global_vars.cpp global_vars.h\n")
    cmake_lists.write("        main.cpp)\n")
    // cmake_lists.write("target_link_libraries(output \"${RUNTIME_LIB_PATH}\")\n")
    cmake_lists.write("target_link_libraries(" + program_name + " runtime)\n")
    cmake_lists.write("target_include_directories(" + program_name +
                      " PUBLIC " + "../src/runtime ../src/gc)\n")
    cmake_lists.close()
    if DEBUG:
        print "--------------- wrote", output_folder + "CMakeLists.txt",
        print         "----------------"
    # compile code
    cmake_configure = "cmake -DCMAKE_BUILD_TYPE=" + CONFIG + " -S " +
            output_folder + " -B " + output_folder + "build" // +  " --fresh"
    cmake_build = "cmake --build " + output_folder + "build"
    if not DEBUG:
        cmake_configure = cmake_configure + " > /dev/null"
        cmake_build = cmake_build + " > /dev/null"
    else:
        print "--------------- running cmake configure step ----------------"
        print "-->", cmake_configure
    display "run", system(cmake_configure)
    if DEBUG:
        print "--------------- finished cmake configure step ---------------"
        print "--------------- running cmake build step --------------------"
        print "-->", cmake_build
    var build_error = system(cmake_build)
    print "run: system(cmake_build) =", build_error
    if isinteger(build_error):
        if DEBUG:
            print "--------------- error", build_error, "in cmake build step --"
        exit(1)
    if DEBUG:
        print "--------------- finished cmake build step -------------------"
        print "--------------- running compiled program --------------------"
        print "-->", "./" + output_folder + "build/" + program_name
    var cmd = output_folder + "build/" + program_name
    var run_error = system(cmd)
    if DEBUG:
        print "--------------- compiled program finished -------------------"
        print "run system(\""; cmd; "\") = "; run_error
        print "--- to run it again, use this command:"
        print "---", "./" + output_folder + "build/" + program_name
        print "-------------------------------------------------------------"
exit(0)
