require "utils"


class ParsedFile:

    var source_file
    var ast

    def init(source_file_, ast_):
        source_file = source_file
        ast = ast


class SourceFile:

    var file_path
    var stream
    var line
    var source_map  // list of starting position of each line
    var offset  // character offset of current (unread) file position

    def init(file_path_):
        file_path = file_path_
        stream = open(file_path, "r")
        offset = 0
        source_map = [0]


    def close():
        stream.close()


    def readline():
    # returns "" at eof
        if line == "":
            print "WARNING: readline after EOF encountered"
            return ""
        line = stream.readline()
        if isnull(line):
            line = ""
        elif len(line) == 0:
            print "WARNING: File does not end in newline"
            line = line + "\n"
        var length = len(line)
        offset = offset + length
        if length > 0:
            source_map.append(offset)
        return line


    def get_range(start, end):
        return Range(file_path, start, end)


    def get_formatted_line_col(pos):
        for line = 0 to len(source_map):
            if source_map[line] > pos:
                col = pos - source_map[line - 1]
                return str(line) + ":" + str(col)
        return "EOF"


    def get_formatted_pos(pos):
        return file_path + ":" + get_formatted_line_col(pos)

        
