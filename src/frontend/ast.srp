require "debug"

# Abstract base class for all
class Expression:
    var classname

    def init():
        var pass = 1

    def accept(visitor):
        var pass = 1



class Literal(Expression):
    var value  # a value of type object_type e.g. 5, "hello", etc.
    var value_type  # : symbol
    var range  # source code location

    def init(ctx, token, optional value_type_):
        super.init()
        value = token.content
        range = token.range
        value_type = value_type_
        if not value_type:
            if value[0] == "\"":
                value_type = 'string'
            elif value[0] == "'":
                value_type = 'symbol'
            elif value == "true" or value == "false" or value == "t":
                value_type = 'bool'
            else:
                value_type = 'int'
                for c in value:
                    if c == ".":
                        if value_type == 'int':
                            value_type = 'real'
                        elif value_type == 'real':
                            ctx.err(value.range, "literal is not valid real")
                            value_type = nil  // signals error
                    elif not isdigit(c):
                        ctx.err(value.range, "literal is not int or real")
                        value_type = nil  // signals error
        

    def accept(visitor):
        visitor.visitLiteral(this)



class Identifier(Expression):
    var name # : string

    def init(name_):
        super.init()
        name = name_


    # get c++ code for local of type ltype
    def cpp_for_local(ltype):
        ("L." if ltype.on_heap() else "csl_") + name

    def cpp_for_global():
        "csg_" + name


    def accept(visitor):
        visitor.visitIdentifier(this)


    def to_string():
        var s = "Identifier " + str(name)
        s



class BinOp(Expression):
    var left # : Expression
    var op  # : string (one of +, -, *, /, %, &, |, ^, <<, >>, **)
    var right # : Expression
    def init(left_, op_, right_):
        super.init()
        left = left_
        op = op_
        right = right_

    def accept(visitor):
        visitor.visitBinOp(this)



class UnaryOp(Expression):
    var op # : string (one of +, -, not, ~)
    var operand # : Expression
    def init(op_, operand_):
        super.init()
        op = op_
        operand = operand_

    def accept(visitor):
        visitor.visitUnaryOp(this)



class Array(Expression):
    var elements # : Array[Expression]
    def init(elements_):
        super.init()
        elements = elements_

    def accept(visitor):
        visitor.visitArray(this)



class Dictionary(Expression):
    var pairs # : Array[Array[Expression, Expression]], no tuples
    def init(pairs_):
        super.init()
        pairs = pairs_

    def accept(visitor):
        visitor.visitDictionary(this)



class ArgumentList:
    var args # : Array [Expression]
    var kwargs # : Dictionary[Identifier, Expression]
    var dispatch
    def init(args_, kwargs_):
        args = args_
        kwargs = kwargs_
        dispatch = 'static'

    def accept(visitor, function_name):
        visitor.visitArgumentList(this, function_name)



class FunctionCall(Expression):
    var name # : string
    var parameters # : ArgumentList
    def init(name_, parameters_):
        super.init()
        name = name_
        parameters = parameters_

    def accept(visitor):
        visitor.visitFunctionCall(this)



class Constructor(Expression):
    var name # : string
    var parameters # : ArgumentList
    # this is isomorphic to FunctionCall
    def init(name_, parameters_):
        super.init()
        name = name_
        parameters = parameters_

    def accept(visitor):
        visitor.visitConstructor(this)



class MethodCall(Expression):
    var object # : Expression
    var method_name # : Identifier
    var parameters # : ArgumentList
    def init(object_, method_name_, parameters_):
        super.init()
        object = object_
        method_name = method_name_
        parameters = parameters_

    def accept(visitor):
        visitor.visitMethodCall(this)



class GetAttribute(Expression):
    var object # : Expression
    var attribute # : string
    var rhs # : bool
    def init(object_, attribute_):
        super.init()
        object = object_
        attribute = attribute_
        rhs = true

    def accept(visitor):
        visitor.visitGetAttribute(this)



class Index(Expression):
    var object # : Expression
    var index # : Expression
    def init(object_, index_):
        super.init()
        object = object_
        index = index_

    def accept(visitor):
        visitor.visitIndex(this)



class BlockElement:

    def accept(visitor):
        pass



class Statement(BlockElement):

    def accept(visitor):
        pass



# TODO: change name for `identifier` (currently preserved for compatibility)
class Assignment(Statement):
    var identifier # : Expression
    var expression # : Expression
    var local_flag # : boolean

    def init(identifier_, expression_, local_flag_):
        super.init()
        identifier = identifier_
        expression = expression_
        local_flag = local_flag_

    def accept(visitor):
        visitor.visitAssignment(this)



class StandaloneExpression(Statement):
    var expression # : Expression
    def init(expression_):
        super.init()
        expression = expression_

    def accept(visitor):
        visitor.visitStandaloneExpression(this)


// SERPENT_TO_CPP_TYPES = {"var": "Any", "int": "int", "real": "double",
//                      "bool": "bool", "array": "Array", "dict": "Dictionary",
//                        "symbol": "Symbol"}



class Declaration(Statement):
    var declared_type # : symbol
    var identifier # : Identifier
    var local_flag  # : boolean

    def init(identifier_, optional declared_type_ = 'any', local_flag_):
        super.init()
        assert(isstring(identifier_))
        declared_type = declared_type_
        identifier = Identifier(identifier_)
        local_flag = local_flag_
        // global_table.add_entry(identifier)

    def accept(visitor):
        visitor.visitDeclaration(this)

    def to_string():
        var id = identifier
        if id and isinstance(id, "Identifier"):
            id = identifier.value
        "<Declaration id=" + str(id) + " type=" + str(declared_type) + ">"



class DeclarationNAssignment(Statement):
    var declared_type # : symbol
    var identifier # : string
    var expression # : Expression
    var local_flag  # : boolean

    def init(declared_type_, identifier_, expression_, ctx):
        super.init()
        declared_type = declared_type_
        identifier = Identifier(identifier_)
        expression = expression_
        local_flag = ctx.in_function

    def accept(visitor):
        visitor.visitDeclarationNAssignment(this)



class ReturnStatement(Statement):
    var expression # : Expression
    def init(expression_):
        super.init()
        expression = expression_

    def accept(visitor):
        visitor.visitReturnStatement(this)



class ControlFlow(BlockElement):

    def accept(visitor):
        pass



class Block:
    var statements # : List[BlockElement]
    var end_token
    var needs_open_brace

    def init(statements_, end_token_):
        statements = statements_
        end_token = end_token_
        needs_open_brace = true

    def accept(visitor):
        visitor.visitBlock(this)



class If(ControlFlow):
    var condition # : Expression # must be a boolean
    var block # : Block
    var else_block # : Block
    def init(condition_, block_, optional else_block_=nil):
        super.init()
        condition = condition_
        block = block_
        else_block = else_block_

    def accept(visitor):
        visitor.visitIf(this)



class While(ControlFlow):
    var condition # : Expression # must be a boolean
    var block # : Block
    def init(condition_, block_):
        super.init()
        condition = condition_
        block = block_

    def accept(visitor):
        visitor.visitWhile(this)



class ForRange(ControlFlow):
    var var_type
    var identifier # : Identifier # loop variable
    var start # : Expression
    var end # : Expression
    var by_amount # : Expression
    var block # : Block

    def init(var_type_, identifier_, start_, end_, by_, block_):
        super.init()
        var_type = var_type_
        identifier = identifier_
        assert(isstring(identifier))
        start = start_
        end = end_
        by_amount = by_
        block = block_

    def accept(visitor):
        visitor.visitForRange(this)



class ForEach(ControlFlow):
    var identifier # : Identifier # loop variable
    var iter # : Expression
    var block # : Block
    def init(identifier_, iter_, block_):
        super.init()
        identifier = identifier_
        iter = iter_
        block = block_

    def accept(visitor):
        visitor.visitForEach(this)



class Function:
    var name # : string
    var signature  # [required, optional, keyword, restparam, dictparam, ftype]
    # where required is [rtype0, rname0, rtype1, rname1, ...], optional is
    # [otype0, oname0, odefault0, otype1, oname1, odefault1, ...], keyword is 
    # [ktype0, kname0, kdefault0, ktype1, kname1, kdefault1, ...], rest is the
    # rest parameter name, keyword_dict is the dictionary name, and ftype is
    # the function return type. (see top of codegen_visitor.srp)
    var block # : Block
    def init(name_, signature_, block_):
        name = name_
        assert(isstring(name))
        signature = signature_
        assert(isstring(signature[5]) or issymbol(signature[5]))
        block = block_

    def accept(visitor):
        visitor.visitFunction(this)



class Class:
    var name # : string
    var parent # : string
    var member_variables # : List[string] # but how to handle types?
    var member_functions # : List[Function]
    var parents // a list of strings
    def init(name_, parent_, member_variables_, member_functions_):
        name = name_
        parent = parent_
        member_variables = member_variables_
        member_functions = member_functions_

    def accept(visitor):
        visitor.visitClass(this)



class File:
    var deps # all depending files, List[string]
    var elements # list of class/function/block elements,
                 #   List[Class | Function | BlockElement]
    def init(deps_, elements_):
        deps = deps_
        elements = elements_

    def accept(visitor):
        visitor.visitFile(this)



# for debugging: print the tree
def print_ast(ast, optional prefix = "", name):
    if isarray(ast):
        for child at i in ast:
            print_ast(child, prefix, str(name) + "[" + str(i) + "]")
        return
    if isdict(ast):
        for key in ast.keys():
            print prefix; key
            print_ast(ast[key], prefix + "---", name)
        return
    print prefix;
    if name:
        print name; ": ";

    if not isobject(ast):
        print str(ast)
        return

    # Extracts the node name from the internal Serpent representation
    // class_name_plus = str(ast)
    // close_paren_idx = find(class_name_plus, ")")
    // class_name = subseq(class_name_plus, 5, close_paren_idx)
    // display "in print_ast", object_class(ast)
    // display "in print_ast", class_name_plus, close_paren_idx, class_name
    # Recursively prints a node and its children
    // originally: print(prefix + class_name)

    if isinstance(ast, Range):
        print ast.file.get_formatted_pos(ast.start)
        return
    if isinstance(ast, Identifier):
        print (ast.classname + "::") if ast.classname else "";
        print ast.name
        return
    if isinstance(ast, Literal):
        print (ast.classname + "::") if ast.classname else "";
        print str(ast.value_type) + ":" + str(ast.value),
        print "@ln" + ast.range.file.get_formatted_line_col(ast.range.start)
        return
    if isinstance(ast, Assignment):
        print "Assignment ";
        var id = ast.identifier
        if ast.local_flag:
            print "(local_flag) "
        if isinstance(id, Identifier):
            print (id.classname + "::") if id.classname else ""; id.name; " to... "
        else:
            print // newline after "Assignment "
            print_ast(id, prefix + "----", "identifier")
        print_ast(ast.expression, prefix + "----", "expression")
        return
    if isinstance(ast, BinOp):
        print "BinOp "; ast.op
        print_ast(ast.left, prefix + "----", 'left')
        print_ast(ast.right, prefix + "----", 'right')
        return

    print str(object_class(ast))
    // if class_name == "Class":
    //     print("DEBUG: " + str(ast.name))
    // if class_name == "Assignment":
    //     print("DEBUG: " + str(ast.expression) + " and " + str(ast.identifier))
    // if class_name == "BinOp":
    //     print("DEBUG: " + str(ast.left) + " and " + str(ast.right))

    var fields = object_variables(ast)
    for child_name in fields.keys():
        if child_name == 'signature':
            print prefix; "----signature: "; ast.signature
        elif child_name != 'classname' or fields[child_name]:
            print_ast(fields[child_name], prefix + "----", child_name)



# Test case for print_ast:
def test_print_ast():
    var ast = File([Declaration(Identifier("a")),
                    Declaration(Identifier("b"))])
    print_ast(ast)
    # Combine the provided ASTs into one larger AST
    combined_ast = File([
    Identifier("test_identifier"),
    BinOp(Identifier("a"), "+", Identifier("b")),
    FunctionCall(Identifier("my_function"), ArgumentList([Identifier("arg1"),
                                                          Identifier("arg2")], {})),
    Class(Identifier("MyClass"), [Declaration(Identifier("var1"), 'any', true)],
          [Function(Identifier("func1"), [], [], Block([]))]),
    File([Declaration(Identifier("var1")), Function(Identifier("func1"), [], [],
                                                    Block([]))])])
    print_ast(combined_ast)
