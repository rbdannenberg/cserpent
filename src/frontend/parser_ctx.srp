require "utils"


def match(token, predicate):
# test if token (Token class) matches specification in predicate
# predicate is:
#    string: token must match the string
#    symbol: token's tk_type must match the symbol
#    array: token must match any string or token type must match any symbol
#
    if isarray(predicate):
        return token.tk_type in predicate or token.content in predicate
    # else token is a string (for exact match) or symbol (for tk_type match)
    return (isstring(predicate) and token.content == predicate) or
           (issymbol(predicate) and token.tk_type == predicate)


// Mutable context object passed along when `Parser` is run on an input.
class ParseContext:

    var tokenizer  // Tokenizer object: source of tokens
    var pos      // 1-D position of the context, i.e., current character pointer
    var error    // Error message.
    var should_ignore_whitespace
    var in_function  // boolean: true if we are parsing a function (where a
                     //          variable declaration is local)

    ### CONTEXT & STUFF ###
    var types
    var deps

    ### SETUPS ###


    def init(tokenizer_):
        pos = 0
        tokenizer = tokenizer_
        error = nil
        should_ignore_whitespace = false

        types = []
        deps = []


    def at_eof():
    # have we reached the end of the file
        var tok = tokenizer.peek()
        // display "$$ at_eof()", tok
        return tok.tk_type == TK_EOF


    ### SHORTHANDS FOR PARSING ###

    def peek_token(optional predicate, optional should_err = true):
    # get the next token that matches predicate, which is a
    # string to match token exactly, a symbol to match the token type,
    # or an array to give a list of string or symbol alternatives
    # If should_err, failure to match causes error report.
        if should_ignore_whitespace:
            before_whitespace = skip_whitespace()

//        if at_eof():
//            if should_err:
//                error("looking for " + str(predicate) + ", got EOF")
        
        var tok = tokenizer.peek()

        if predicate and not match(tok, predicate):
            if should_err:
                err_expect(tok, predicate)
            if should_ignore_whitespace:
                pos = before_whitespace
            // display "peek_token returns", nil
            return nil

        // display "peek_token returns", tok
        return tok


    def get_token(optional predicate, optional should_err = true):
        var rslt = peek_token(predicate, should_err)
        if rslt:
            // display "get_token in parser_ctx: success", rslt
            return tokenizer.next()
        return nil


    def unget_token(token)
        tokenizer.undo_next(token)


    def indent():
        return get_token(TK_INDENT)


    def dedent():
        return get_token(TK_DEDENT)

    def br():
        return get_token(TK_NEWLINE)


    ### ERROR EMISSION AND HANDLING ###

    def ok():
        return error == nil

    def err(range, msg):
        error = Error(range, msg)

    def err_eof():
        err(nil, "unexpected end of file")

    def err_eof_with(predicate):
        err(nil, "unexpected end of file (expected " + str(predicate) + ")")

    def err_expect(tok, predicate):
        err(tok.range, "expected " + str(predicate) + ", got " + tok.render())

    def err_fset_miss(predicate):
        if at_eof():
            err_eof_with(predicate)

        err_expect(peek_token(), predicate)

    
    ### INDENTATION CONTEXT ###

    def possible_linewrap():
        tokenizer.linewrap_flag = true

    def skip_whitespace():
        var curr_pos = pos
        for i = pos to len(input):
            if not match(input[i], [TK_INDENT, TK_DEDENT, TK_NEWLINE]):
                pos = i
                return curr_pos
        
        return curr_pos


    def skip_eol():
        return get_token([TK_NEWLINE, ";"])

    
    ### MISC CONTEXT ###

    def is_type(iden):
        return iden in types

    
    def add_type(iden):
        types.append(iden)


    # When on, all encountered indentations and linebreaks will be skipped.
    def ignore_whitespace(state):
        prev = should_ignore_whitespace
        should_ignore_whitespace = state
        return prev


    def get_partial(idx):
        return partial[idx]


    def pop_partial():
        if len(partial) != 1:
            print partial
            print "DEBUG ERROR: POPPING FROM EMPTY PARTIAL"
            runtime_exception("STOP", frame_get())
        part = partial[0]
        partial.clear()
        return part

    def clear_partial(idx):
        partial.clear()


    ### Deps ###

    def add_dep(path):
        if path not in deps:
            deps.append(path)
