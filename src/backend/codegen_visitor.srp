    def write_cs_header(cpp_file, filename):
    # write standard includes for CSerpent modules. Omit <filename>.h if 
    # filename is nil
        cpp_file.write("#include \"cserpent.h\"\n")
        if filename:
            cpp_file.write("#include \"" + filename + ".h\"\n")
        cpp_file.write("#include \"global_vars.h\"\n\n")
        cpp_file.write("#include \"symbol_table.h\"\n\n")


    def generate_code(filename, ast, deps):
        reset()
        add_line(FOR_MAIN, "int " + filename + "_main()\n{")
        var mld = []  // "Main Locals Declaration" (mld) is a place-holder
                      // for local declarations. This will be written after
                      // we generate code with all locals.
        main_lines.append(mld)
        indent_level = 1
        ast.accept(this)
        if not last_statement_is_return:  // need a final return statement
            add_line(FOR_MAIN, "CS_FUNCTION_EXIT(L, 0);")
        indent_level = 0
        add_line(FOR_MAIN, "}")

        // declarations for local variables in main (function_locals)
        mld.append("    struct Frame : public Cs_frame {\n")
        for name in function_locals.keys():
            var type = function_locals[name]
            if non_ptr_type(type):
                mld.append("        " + TYPE_TO_CPP_TYPE[type] +
                           " " + name + ";\n")
        mld.append("    } L;\n")

        var last_i = -1
        for name at i in function_locals.keys():
            mld.append("    constexpr int SL_" + name + " = " + str(i) + ";\n")
            last_i = i
        mld.append("    memset(&L, 0, sizeof(L));\n")
        mld.append("    CS_FUNCTION_ENTRY(L, " + str(last_i + 1) + ");\n")
        for name in function_locals.keys():
            var type = function_locals[name]
            if non_ptr_type(type):
                mld.append("    " + type + " " + name + ";\n")

        var cpp_file_name = output_folder + "/" + filename + ".cpp"
        var cpp_file = open(cpp_file_name, "w")
        write_cs_header(cpp_file, filename)
        for line in main_includes:
            display "ignoring main_includes in generate_main", line
            # cpp_file.write(line + "\n")
        // we *could* just write flatten(main_lines) etc., but rather than
        // constructing another giant string, we write each top-level element
        // separately since they are mostly strings. But there could be
        // nested arrays containing code, so flatten any nested arrays. (We
        // could also make a recursive write that writes each leaf (string)
        // in nested arrays, but that's not necessarily faster or particularly
        // memory-saving.)
        for s in main_lines:
            cpp_file.write(flatten(s))
        for s in cpp_lines:
            cpp_file.write(flatten(s))
        // cpp_file.write("// other globals should be marked here:\n")
        // TODO: mark the globals here
        cpp_file.close()

        if debug:
            cpp_file = open(cpp_file_name, "r")
            var cpp_content = cpp_file.readlines()
            print "--------------", cpp_file_name, "----------------"
            print flatten(cpp_content);
            print "-------------- end of ", cpp_file_name, "----------------"

        var header_file = open(output_folder + "/" + filename + ".h", "w")
        for dep in deps:
            header_file.write("#include \"" + dep + ".h\"\n")
        for line in header_lines:
            header_file.write(line + "\n")
        header_file.close()
        reset()


    def generate_globals():
        var global_vars_file = open(output_folder + "/global_vars.h", "w")
        var global_cpp_file = open(output_folder + "/global_vars.cpp", "w")

        global_vars_file.write("#pragma once\n")
        write_cs_header(global_cpp_file, nil)
//        for line in main_includes:
//            assert(false) // is main_file defined?  Fix this.
//            main_file.write(line + "\n")
//            global_cpp_file.write(line + "\n")

        display "** generate_globals", global_variables
        var before_s = "Symbol *"
        for global_variable in global_variables.keys():
            string = global_variables[global_variable]
            prefix = subseq(string, 0, 6)
            var type = global_variables[global_variable]
            if prefix == "string":
                global_vars_file.write("extern StringPtr " + global_variable +
                                       ";\n")
                global_cpp_file.write("StringPtr " + global_variable + ";\n")
            else:
                display repr(global_variable), repr(type)
                global_vars_file.write("extern " + type + " " +
                                       global_variable + ";\n")
                var initial_value = " = 0"
                if type == "Any":
                    initial_value = ""
                global_cpp_file.write(type + " " + global_variable +
                                      initial_value + ";\n")
        global_cpp_file.write("\nint cs_global_init()\n{\n")
        global_cpp_file.write("    // Initialize global variables here\n")
        for global_variable in global_variables.keys():
            string = global_variables[global_variable]
            prefix = subseq(string, 0, 6)
            text = subseq(string, 6, -1)
            type = global_variables[global_variable]
            if prefix == "string":
                global_cpp_file.write("    " + global_variable +
                                      " = StringPtr{new String(" +
                                      text + "\")};\n")
            else:
                 // output: Symbol *s = get_symbol("a");
                global_cpp_file.write("    " + before_s + "s = get_symbol(\"" +
                                      subseq(global_variable, 4) + "\");\n")
                before_s = ""  // only declare it the first time, then reuse s
                // output: *(s->value()) = (Any *) &csg_a;
                global_cpp_file.write("    *(s->value()) = (Any *) &" + 
                                      global_variable + ";\n")
                // output: s->symbol_type() = Any_type::???
                global_cpp_file.write("    *(s->symbol_type()) = " +
                                      CPP_TYPE_TO_TYPE_CODE[type] + ";\n")
        global_vars_file.write("int cs_global_init();\n")
//        global_cpp_file.write("    CS_FUNCTION_EXIT(L, 0);\n")
        global_cpp_file.write("}\n")
        global_vars_file.close()
        global_cpp_file.close()

