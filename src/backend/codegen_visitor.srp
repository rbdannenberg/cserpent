# codegen_visitor.srp -- code generator
#
# The basic idea is to do a depth-first traversal of the AST, producing
# code as strings as you go. Code is generated one statement at a time,
# although this is somewhat complicated by the fact that a statement
# can be a block containing statements or more blocks.
#     Often, statements involve nested expressions leading to intermediate
# results that, due to garbage collection, must be stored and made
# observable. A key idea making this possible is that code for a statement
# is consolidated into a single string and output at the end of the
# statement compilation. During the compilation, "preparatory" statements
# can be created where intermediate values are computed and assigned to
# temporary variables that are used subsequently. These "preparatory"
# statements are output as a side-effect of expression evaluation.
#     The code generator has methods to handle each kind of AST node.
# These are all named "visitSomething" and there are basically two kinds
# of "visit" functions: Functions that produce statements, such as
# visitAssignment or visitForRange do not return results and generate
# code as a side effect. Functions that compile expressions, such as
# visitBinOp or visitFunctionCall return Value objects representing the
# type and the compiled expression. These *may* also output complete
# "preparatory" statements as a side effect.

require "src/backend/visitor.srp"
require "src/frontend/ast.srp"

function_corrections = {
    "main": "main__",
    "str": "force_str",
    "int": "force_int" }


// destination parameter values for add_line
FOR_CPP = 'cpp'
FOR_H = 'h'
FOR_MAIN = 'main'

// do we need this?

//CPP_TYPE_TO_TYPE_CODE = {
//    "int": "Any_type::INT",
//    "double": "Any_type::REAL",
//    "bool": "Any_type::BOOL",
//    "Any": "Any_type::NIL",  // means "Any"
//    "array": "Any_type::ARRAY",
//    "dict": "Any_type::DICT",
//    "symbol": "Any_type::SYMBOL"
//    }
//

TYPE_TO_TYPE_CODE = {
    'int': "Any_type::INT",
    'real': "Any_type::REAL",
    'bool': "Any_type::BOOL",
    'any': "Any_type::NIL",  // means 'Any'
    'array': "Any_type::ARRAY",
    'dict': "Any_type::DICT",
    'symbol': "Any_type::SYMBOL"
}


TYPE_TO_CPP_TYPE = {
    'int': "int",
    'real': "double",
    'bool': "bool",
    'any': "Any",
    'array': "ArrayPtr",
    'dict': "DictPtr" }

// this is a bit of a hack, but "types" in global_variables get
// various strings, e.g. some representing string constants, so
// we check for both symbol and string versions of type names:
// NON_PTR_TYPES = ['int', 'real', 'bool', "int", "real", "bool"]

// def non_ptr_type(type):
//     display "non_ptr_type", type, type in NON_PTR_TYPES
//     type in NON_PTR_TYPES


NON_HEAP_TYPES = ['int', 'real', 'bool']


class Type:
    var typ   // the type of the value
    var string_const  // if type is literal string, this is the literal
    
    def init(typ_, optional string_const_):
        assert(issymbol(typ_))
        typ = 'any' if typ_ == 'var' else typ_
        string_const = string_const_
        
    def to_str():
        var scstr = (" lit " + repr(string_const)) if string_const else ""
        "<Type: " + repr(typ) + scstr + ">"

    def is_string_type(): typ == 'string'

    def type_code(): TYPE_TO_TYPE_CODE[typ]

    def c_type(): TYPE_TO_CPP_TYPE[typ]

    def not_an_any(): typ != 'any'

    def not_on_heap(): typ in NON_HEAP_TYPES

    def on_heap(): typ not in NON_HEAP_TYPES



STRING = Type('string')
INT = Type('int')
REAL = Type('real')
ANY = Type('any')
ARRAY = Type('array')
DICT = Type('dict')
BOOL = Type('bool')



class Value:
    var cpp   // the code that delivers the value
    var typ   // the Type description

    def init(type_, cpp_):
        assert(isinstance(type_, Type))
        typ = type_
        cpp = cpp_

    def to_str():
        "<Value " + repr(cpp) + " typ " + str(typ) + ">"

    def is_string_type(): typ.is_string_typ()

    def type_code(): typ.type_code()

    def not_an_any(): typ.not_an_any()



class CodegenVisitor(ASTVisitor):
    var output_folder  // path to output (C++) files
    var cpp_lines
    var header_lines
    var main_lines
    var main_includes
    // locals will contain dictionary from name->type. Code will be
    // generated from this.  Note that locals can be int or real.
    // Even though not special code is needed for these, we put them
    // in the dictionary because they can take priority over globals
    // or class instance variables with the same name.
    var function_locals  // locals info for current function body
        // also, function_locals is for *_main, when not defining a function
    var header_includes
    var current_class
    var in_function  // true if in function (or method if current_class)
    var h_indent_level
    var cpp_indent_level
    var main_indent_level
    var include_list
    var user_defined_classes
    var global_variables  // maps from global name to type, but a special
                 // case is string constants value looks like string"foo"
    var hoisted_strings // maps literal to variable name
    var string_counter
    var temp_counters  // next available temp variable name of each type
    var last_statement_is_return  // do we need a final return?

    def init(_output_folder):
        super.init()
        output_folder = _output_folder
        reset()
        include_list = "#pragma once\n#include <runtime.h>\n"
        indentation = "    "
        user_defined_classes = []
        global_variables = {}
        hoisted_strings = {}
        string_counter = 0
        temp_counters = {}
        function_locals = {}  // for main


    def reset():
        cpp_lines = []  // strings to be flattened
        header_lines = []  // strings to be flattened
        main_includes = []  // strings to be flattened
        main_lines = []
        h_indent_level = 0
        cpp_indent_level = 0
        main_indent_level = 0


    def add_to_cpp(line, optional indent):
        add_line(FOR_CPP, line, indent)


    def add_to_h(line, optional indent):
        add_line(FOR_H, line, indent)


    def add_line(dest, line, optional indent):
    # adds a C++ cpp line or .h line.
    # dest is FOR_CPP for .cpp and FOR_H for .h files.
    # If not in_function, FOR_CPP means append to main_lines,
    # otherwise, FOR_CPP means append to cpp_lines
    # To force append to main_lines, use FOR_MAIN.
    # "main" means global statements become statements in <file>_main().
        var lines
        var indent_level
        if dest == FOR_H:
            lines = header_lines
            indent_level = h_indent_level
        elif dest == FOR_MAIN:  // overrides in_function
            lines = main_lines
            indent_level = main_indent_level
        elif in_function:
            lines = cpp_lines
            indent_level = cpp_indent_level
        else:
            lines = main_lines
            indent_level = main_indent_level
            display "Hmm, not main or function", dest, line
        indent = indent or indent_level
        for i = 0 to indent:
            lines.append(indentation)
        lines.append(line)
        lines.append("\n")


#    def add_line(line, optional ctx = nil):
#        if ctx == nil:
#            ctx = context
#        for i = 0 to indent_levels[ctx]:
#            line = indentation + line
#        if ctx == CTX_SOURCE:
#            cpp_lines.append(line)
#        elif ctx == CTX_HEADER:
#            header_lines.append(line)
#        else:  // CTX_MAIN
#            main_lines.append(line)


    def begin_statement():
    # returns info that should be passed to end_statement when the
    # statement has finished compiling. This is used to "free"
    # the temporary variables that were used to execute the statement
        return temp_counters.copy()


    def end_statement(state):
    # restores state to where it was before the statement was compiled
        // state is just a copy of temp_counters
        temp_counters = state


    def allocate_temp(typ):
        display "allocate_temp", typ, typ.not_on_heap(), function_locals
        var count = temp_counters.get(typ, 0)
        var name = "temp_" + str(typ.typ) + "_" + str(count)
        temp_counters[typ.typ] = count + 1
        # need to create a new local variable for temporary?
        if not function_locals.has_key(name):
            function_locals[name] = typ
            if typ.not_on_heap():
                add_to_cpp(typ.c_type() + " " + name + ";")
        return name


    def assign_to_global(name, value):
        // if the global is declared as int, real, or bool, we can
        // set it directly after coercing the value:
        var gtype = global_variables[name]
        if gtype.not_an_any():
            if not value.not_an_any():
                value.cpp = "as_" + gtype + "("
            code_line = name + " = ("
        else:  // otherwise, use set_any_global():
            code_line = "set_any_global(&" + name + ", "
        add_to_cpp(code_line + value.cpp + ");")


    def visitLiteral(literal):
        # print literal.value, type(literal.value), isstring(literal.value)
        if literal.value_type == 'string':
            var text = literal.value
            var typ = Type('string', text)
            if not hoisted_strings.has_key(text):
                var var_name = "string_" + str(string_counter)
                string_counter = string_counter + 1
                hoisted_strings[text] = var_name
                global_variables[var_name] = typ
            return Value(typ, hoisted_strings[text])
        elif literal.value_type == 'symbol':
            print "ERROR: need to implement literal symbols"
            exit()
            // return "Symbol {\"" + subseq(str(literal.value), 1, -1) + "\"}"
            // in global_vars.{h,cpp}, make globals to hold pointer to symbols
            // When global vars are initiated, if there is already a symbol
            // stored in a global, you can avoid looking it up.
            // return the global name here.
        elif not isstring(literal.value):
            print "Internal Error: expecting literal.value to be string: ";
            print     repr(literal.value)
            exit(1)
        elif literal.value_type == 'int':
            typ = INT
        elif literal.value_type == 'real':
            typ = REAL
        elif literal.value_type == 'bool':
            typ = BOOL
        else:
            print "Error:", literal.value, "is not recognized"
            exit(1)
        return Value(typ, literal.value)


    def visitIdentifier(identifier):
        // local variables shadow member variables
        display "visitIdentifier", identifier.name,
        display         function_locals.get(identifier.name, "not here")
        if function_locals.has_key(identifier.name):
            return Value(function_locals[identifier.name],
                         identifier.cpp_for_local())
        # needs to encapsulate all inherited member variables:
        # not sure why we need "get_" instead of just name
        if current_class and identifier.name in current_class.member_variables:
            # also need parser to encode member_variables as
            # dict from name to type so we can return correct type:
            return Value(ANY, "get_" + identifier.name + "()")
        // not a declared local or instance variable, so must be a global
        var ident = identifier.cpp_for_global()
        // if global is implicitly declared, insert into global_variables
        if not global_variables.has_key(ident):
            display "** visitIdentifier", identifier
            // if identifier.cpp_for_global() == "csg_b":
            //     print "=================================================="
            //     stacktrace()
            //     print "=================================================="
            global_variables[ident] = ANY
        display "calling Value", ident, repr(global_variables[ident])
        return Value(global_variables[ident], ident)


    def visitBoolOp(bool_op):
        return Value(BOOL, bool_op.left.accept(this).cpp + " " + bool_op.op +
                             " " + bool_op.right.accept(this).cpp)


    def visitBinOp(bin_op):
        var func = nil
        var typ = REAL
        var left = bin_op.left.accept(this)
        var right = bin_op.right.accept(this)

        if bin_op.op == "**":
            func = "pow"
        if bin_op.op == "is":
            func = "is_equal"
            typ = BOOL
        if func:
            return Value(typ, func + "(" + left.cpp + ", " + right.cpp + ")")
        # this is probably wrong. It assumes int if left and right are int,
        # and real otherwise (also, real for "/" operator)
        if (left.typ == INT and right.typ == INT and bin_op.op != "/"):
            typ = INT
        return Value(typ, "(" + left.cpp + ") " + bin_op.op +
                          " (" + right.cpp + ")")


    def visitUnaryOp(unary_op):
        var typ = REAL
        var operand = unary_op.operand.accept(this)
        if unary_op.op == "not":
            unary_op.op = "!"
            typ = BOOL
        # this is probably wrong. It assumes int if operand is int,
        elif operand.typ == 'int':
            typ = INT
        return Value(typ, unary_op.op + "(" + operand.cpp + ")")


    def visitArray(array_node):        # array literal
        var temp = allocate_temp(ARRAY)
        display "visitArray", temp
        add_to_cpp("L.set(SL_" + temp + ", Any {new Array(" +
                   str(len(array_node.elements)) + ", nil)});")
        for element at i in array_node.elements:
            add_to_cpp("L." + temp + "->set(" + str(i) + ", " +
                       element.accept(this).cpp + ");")
        return Value(ARRAY, "L." + temp)


    def visitDictionary(dictionary_node):
        var temp = allocate_temp(DICT)
        add_to_cpp("L.set(SL_" + temp + ", Any {new Dict()});")
        for pair at i in dictionary.pairs:
            add_to_cpp("L." + temp + "->set(" + pair[0].accept(this).cpp +
                       ", " + pair[1].accept(this).cpp + ");")
        return Value(DICT, "L." + temp)


    def visitArgumentList(arg_list):
    # this is "special" because it returns a string rather than Value
        var kwargs = arg_list.kwargs
        var code_str = ""
        if len(arg_list.args) == 0 and arg_list.dispatch == "dynamic":
            code_str = "empty_array"
        else:
            if arg_list.dispatch == "dynamic":
                code_str = code_str + "Array {"

            for i = 0 to len(arg_list.args):
                code_str = code_str + arg_list.args[i].accept(this).cpp
                if i < len(arg_list.args) - 1
                    code_str = code_str + ", "

            if arg_list.dispatch == "dynamic":
                code_str = code_str + "}"

        if arg_list.dispatch == "dynamic" or len(kwargs.keys()) > 0:
            if len(kwargs.keys()) == 0:
                code_str = code_str + ", empty_dict"
            else:
                code_str = code_str + ", Dict {"
                for i = 0 to len(kwargs.keys()):
                    key = kwargs.keys()[i]
                    code_str = code_str + "{" + key.accept(this).cpp + ", " +
                               kwargs[key].accept(this).cpp + "}"
                    if i < len(kwargs) - 1:
                        code_str = code_str + ", "
                code_str = code_str + "}"
        return code_str


    def visitFunctionCall(fcall):
        if fcall.name in user_defined_classes:
            return visitConstructor(fcall)
        if fcall.name in function_corrections.keys():
            fcall.name = function_corrections[fcall.name]
        var code_str
        var args = fcall.parameters.args
        if fcall.name == "print" or fcall.name == "display":
            code_str = "std::cout << "
            if len(fcall.parameters.kwargs) != 0:
                print "Error: print function does not take keyword arguments"
                exit()
            for i = 0 to len(args):
                code_str = code_str + "(" + args[i].accept(this).cpp + ")"
                if i < len(args) - 1:
                    code_str = code_str + " << "
            code_str = code_str + " << std::endl"
        elif fcall.name == "exit":
            code_str = "exit(0)"
        elif fcall.name == "funcall":
            code_str = "apply(" + fcall.parameters.args[0].accept(this)
            code_str = code_str + ", *(new Array {"
            for i = 1 to len(args):
                code_str = code_str + args[i].accept(this).cpp
                if i < len(args) - 1
                    code_str = code_str + ", "
            code_str = code_str + "}))"
        elif fcall.name == "send":
            code_str = "sendapply(" +
                       fcall.parameters.args[0].accept(this).cpp +
                       ", " + fcall.parameters.args[1].accept(this).cpp +
                       ", *(new Array {"
            for i = 2 to len(args):
                code_str = code_str + args[i].accept(this).cpp
                if i < len(args) - 1
                    code_str = code_str + ", "
            code_str = code_str + "}))"
        else:
            code_str = fcall.name + "(" + fcall.parameters.accept(this)
            code_str = code_str + ")"
        return Value(ANY, code_str)


    def visitConstructor(constr):
        return Value(Type(intern(constr.name)),
                     "(new " + constr.name + " {" +
                     constr.parameters.accept(this).cpp + "})")


    def visitMethodCall(mcall):
        var code_str = mcall.object.accept(this).cpp
        # Special case for append method - call it directly
        if mcall.method_name == "append":
            code_str = code_str + ".append("
            # Append should have exactly one argument
            if len(mcall.parameters.args) == 1:
                code_str = code_str + mcall.parameters.args[0].accept(this).cpp
            code_str = code_str + ")"
        else:
            # General case using .call()
            code_str = code_str + ".call(\"" + mcall.method_name + "\", "
            mcall.parameters.dispatch = "dynamic"
            code_str = code_str + mcall.parameters.accept(this).cpp + ")"
        return Value(ANY, code_str)


    def visitGetAttribute(get_attribute):
    # this needs work -- why do we need to call get_<attribute>?
        return get_attribute.object.accept(this).cpp + ".call(\"get_" +
               get_attribute.attribute + "\", empty_array, empty_dict)"


    def visitIndex(index):
        return Value(ANY, index.object.accept(this).cpp + "[to_int(" + 
                          index.index.accept(this).cpp + ")]")


    def visitAssignment(assign):
        var ident = assign.identifier
        var value
        if isinstance(ident, GetAttribute):
            # does this handle a.b.c[x].h = ?
            code_line = ident.accept(this).cpp
            # this all seems wrong - at least not fast when types are known
#             code_line = code_line + ".call(\"set_" +
#                 ident.attribute + "\", Array {"
#             assign.expression.accept(this)
#            add_line(curr_code_line + "}, empty_dict);")
#            curr_code_line = ""
            return

        if isinstance(ident, Index):
            # does this handle a[2].b.c[x].h = ?
# this all seems wrong - at least not fast when types are known
#            index_obj = ident
#            index_obj.object.accept(this)
#            curr_code_line = curr_code_line + ".set(to_int("
#            index_obj.index.accept(this)
#            curr_code_line = curr_code_line + "), "
#            assign.expression.accept(this)
#            add_line(curr_code_line + ");")
#            curr_code_line = ""
            return

        var name = ident.name
        if current_class and isinstance(ident, Identifier) and
           name in current_class.member_variables:
            code_line = "set_" + name + "(" + 
                        assign.expression.accept(this).cpp + ");"
            add_to_cpp(code_line)
            return

        # not member, so must be global or local

        value = assign.expression.accept(this)
        // see if it is local
        if in_function and function_locals.has_key(name):  // it's local
            # non-ptr can just be directly assigned
            if function_locals[name].not_an_any():
                if not value.not_an_any():
                    value.cpp = "as_" + function_locals[name] + "(" +
                                value.cpp + ")"
                add_to_cpp(name + " = " + value.cpp + ";")
            else:
                add_to_cpp("L.set(SL_" + name + ", " + value.cpp + ");")
        else: // it's global
            if isinstance(ident, Identifier) and current_class == nil:
               global_variables[ident.cpp_for_global()] = ANY
            assign_to_global(ident.cpp_for_global(), value)


    def visitStandaloneExpression(standalone_expression):
        var code_line = standalone_expression.expression.accept(this)
        add_to_cpp(code_line.cpp + ";")


    def visitDeclaration(declaration):
        // add_line(declaration.declared_type + " " +
        //          declaration.identifier.value + ";")
        display "** visitDeclaration", declaration.declared_type,
        display         declaration.identifier.name
        global_variables[declaration.identifier.cpp_for_global()] =
                Type(declaration.declared_type)


    def visitDeclarationNAssignment(d_and_a):
        display "visitDeclAssign", d_and_a.identifier.name
        var name = d_and_a.identifier.name
        var code_line
        if in_function:
            if function_locals.has_key(name)
                print "ERROR: local", d_and_a.identifier.name,
                print     "already declared."
                exit();
            function_locals[name] = intern(d_and_a.declared_type)
            if d_and_a.declared_type in ['int', 'real', 'bool']:
                code_line = TYPE_TO_CPP_TYPE(d_and_a.declared_type) + " " +
                            name + " = ("
            else:
                code_line = "L.set(SL_" + name + ", "
            add_to_cpp(code_line + ");")            
        else:  // this is a global declaration
            var ident = d_and_a.identifier
            display "** visitDeclarationNAssignment", d_and_a.declared_type,
            display         ident.name, type(d_and_a.declared_type)
            global_variables[ident.cpp_for_global()] = 
                    Type(d_and_a.declared_type)
            display "   ", global_variables[ident.cpp_for_global()],
            display     ident.cpp_for_global()

            assign_to_global(ident.cpp_for_global(),
                             d_and_a.expression.accept(this))


    def visitReturnStatement(return_statement):
        add_to_cpp("CS_FUNCTION_EXIT(L, " +
                   return_statement.expression.accept(this).cpp + ");")
        if cpp_indent_level == 1:
            last_statement_is_return = true
        // otherwise, we're returning from inside a block and we cannot assume
        // a return statement will be reached


    def visitBlock(block):
        // top of function must place local declarations after "{" so we do
        // not want to output the "{" here. Other blocks need a "{" at start.
        if block.needs_open_brace:
            add_to_cpp("{")
        cpp_indent_level = cpp_indent_level + 1
        for statement in block.statements:
            var state = begin_statement()
            last_statement_is_return = false;
            statement.accept(this)
            end_statement(state)
        cpp_indent_level = cpp_indent_level - 1
        add_to_cpp("}")


    def visitIf(if_statement):
        var code_line = "if (to_bool(" + if_statement.condition.accept(this)
        add_to_cpp(code_line + "))")
        if_statement.block.accept(this)
        if if_statement.else_block is not nil:
            add_line("else")
            if_statement.else_block.accept(this)


    def visitWhile(while_stmt):
        var code_line = "while (to_bool(" + while_stmt.condition.accept(this)
        add_to_cpp(code_line + "))")
        while_stmt.block.accept(this)


    def visitForRange(stmt):
        display "visitForRange", stmt.start
        if not function_locals.has_key(stmt.identifier):
            function_locals[stmt.identifier] = INT
        var code_line = "for (csl_" + stmt.identifier + " = " +
                        stmt.start.accept(this).cpp + "; csl_" +
                        stmt.identifier + " < " + stmt.end.accept(this).cpp +
                        "; csl_" + stmt.identifier + " += " +
                        stmt.by_amount.accept(this).cpp
        add_to_cpp(code_line + ")")
        stmt.block.accept(this)


    def visitForEach(stmt):
        var code_line = "for (auto " + stmt.identifier.name + " : " + 
                        stmt.iterable.accept(this) + ")"
        add_to_cpp(code_line)
        stmt.block.accept(this)


    def visitFunction(function):
        assert(not in_function)
        in_function = true

        var main_function_locals = function_locals
        function_locals = {}  // new name space inside function

        var main_temp_counters = temp_counters
        temp_counters = {}  // new name space inside function

        num_args = len(function.positional)
        if function.name == "main":
            function.name = "main__"

        # collect arguments within the parentheses
        var code_line = function.name + "("
        for i = 0 to num_args:
            # Change this once type inference exists:
            code_line = code_line + "Any " + function.positional[i]
            if i < num_args - 1:
                code_line = code_line + ", "
        code_line = code_line + ")"

        var global_line = "\nAny " + "global_" + function.name +
                          "(const Array& args, const Dict &kwargs)"

        add_to_h("Any " + code_line + ";")
        if current_class:
            add_to_cpp("\nAny " + current_class.name + "::" +
                                   code_line)
        else:
            add_to_cpp("\nAny " + code_line)

        var fld = []  // function local declarations
        add_to_cpp("\n{")
        function.block.needs_open_brace = false  // we do not want top-level
                               // function blocks to output "{" at the start
        cpp_lines.append(fld)

        # make corrections to the block
        var last_statement = function.block.statements.last()
        if not isinstance(last_statement, ReturnStatement):
            if isinstance(last_statement, StandaloneExpression):
                function.block.statements[len(function.block.statements) - 1] =
                        ReturnStatement(last_statement.expression)
            else:
                function.block.statements.append(
                        ReturnStatement(Literal("nil", "Any")))
        function.block.accept(this)

        generate_locals_and_entry(fld)

        if not current_class:
            # function is global
            add_to_h(global_line + ";")
            add_to_cpp(global_line + "\n{")
            add_to_cpp("check_dispatch(\"" + function.name + "\" args, " +
                       "kwargs, " + str(len(function.positional)) + 
                       ", " + str(len(function.optional)) + ");", 1)
            var call = "return " + function.name + "("
            for i = 0 to num_args:
                call = call + "args[" + str(i) + "]"
                if i < num_args - 1:
                    call = call + ", "
            call = call + ");"
            add_to_cpp(call, 1)
            add_to_cpp("}")
            add_line(FOR_MAIN, "cs_symbol_table->intern(\"" + function.name +
                               "\")->set_slot(1, (Any *) &global_" + 
                               function.name + ");")
        in_function = false
        function_locals = main_function_locals  // restore
        temp_counters = main_temp_counters  // restore
        function_locals.clear()  // delete locals


    def visitClass(class_):
        current_class = class_
        user_defined_classes.append(class_.name)
        var class_ptr = class_.name + "_class"
        var function_list = []
        add_to_h("extern Cs_class * " + class_ptr + ";")
        add_to_h("class " + class_.name + " : public Obj {")
        add_to_h("public:")
        cpp_indent_level = 1
        add_to_h("Any more_slots[" + 
                               str(len(class_.member_variables)) + "];")
        add_to_h(class_.name + "() : Obj {" + class_ptr + "} {}")

        for variable at index in class_.member_variables:
            var variable_str = variable
            var getter = "get_" + variable_str
            var setter = "set_" + variable_str
            
            add_to_h("Any " + getter + "() {")
            # since slot 0 is for class pointer:
            add_to_h("return slots[" + str(index + 1) + "];", 2)
            add_to_h("}")
            add_to_h("Any " + setter + "(Any value) {")
            add_to_h("set_slot(" + str(index + 1) + ", value);",
                     2)
            add_to_h("return nil;", 2)
            add_to_h("}")

            function_list.append([getter, 0, 0])
            function_list.append([setter, 1, 0])


        for function in class_.member_functions:
            function.accept(this)
            function_list.append([function.name, len(function.positional),
                                  len(function.optional)])
            if function.name == "init":
                var num_args = len(function.positional)
                var enclosed = ""

                var code_line = class_.name + "("
                for i = 0 to num_args:
                    # Change this once type inference exists:
                    code_line = code_line + "Any " + function.positional[i]
                    enclosed = enclosed + function.positional[i]
                    if i < num_args - 1:
                        code_line = code_line + ", "
                        enclosed = enclosed + ", "
                code_line = code_line + ") : Obj {" + class_ptr + "} {"
                add_to_h(code_line)
                add_to_h("init(" + enclosed + ");", 2)
                add_to_h("}")

        cpp_indent_level = 0
        add_to_h("};")

        # Define global functions for each class member function
        for function in function_list:
            var function_name = function[0]
            var signature = "Any " + class_.name + "_" + function_name +
                    "(Obj* self, const Array& args, const Dict &kwargs)"
            add_to_h(signature + ";")
            add_to_cpp(signature + " {")
            cpp_indent_level = 1
            add_to_cpp("check_dispatch(\"" + function_name +
                                   "\", args, kwargs," + str(function[1]) +
                                   "," + str(function[2]) + ");")
            var dispatch_line = "reinterpret_cast<" + class_.name +
                                "*>(self)->" + function_name + "("
            for i = 0 to function[1]:
                dispatch_line = dispatch_line + "args[" + str(i) + "]"
                if i < function[1] - 1:
                    dispatch_line = dispatch_line + ", "
            dispatch_line = dispatch_line + ");"
            add_to_cpp("return " + dispatch_line)
            cpp_indent_level = 0
            add_to_cpp("}")

        # Create the MemberTable that maps symbols to function pointers
        var table_name = "MemberTable " + class_.name + "_table"
        add_to_h("extern " + table_name + ";")
        add_to_cpp(table_name + " {")
        cpp_indent_level = cpp_indent_level + 1
        for function in function_list:
            add_to_cpp("{Symbol{\"" + function[0] + "\"}, " +
                                   class_.name + "_" + function[0] + "},")
        cpp_indent_level = 0
        add_to_cpp("};")

        # NOTE: 0b0 should be changed once type inference is implemented and
        #       we have pointer types
        var cs_class_init = "{Symbol {\"" + class_.name + "\"}, " +
                            str(len(class_.member_variables)) + ", 0b0, &" +
                            class_.name + "_table};"
        add_to_cpp("Cs_class * " + class_ptr +
                               " = new Cs_class " + cs_class_init)
        current_class = nil


    def visitFile(file):
        add_to_h(include_list)
        for element in file.elements:
            element.accept(this)


