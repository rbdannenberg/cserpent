# codegen_visitor.srp -- code generator
#
# The basic idea is to do a depth-first traversal of the AST, producing
# code as strings as you go. Code is generated one statement at a time,
# although this is somewhat complicated by the fact that a statement
# can be a block containing statements or more blocks.
#     Often, statements involve nested expressions leading to intermediate
# results that, due to garbage collection, must be stored and made
# observable. A key idea making this possible is that code for a statement
# is consolidated into a single string and output at the end of the
# statement compilation. During the compilation, "preparatory" statements
# can be created where intermediate values are computed and assigned to
# temporary variables that are used subsequently. These "preparatory"
# statements are output as a side-effect of expression evaluation.
#     The code generator has methods to handle each kind of AST node.
# These are all named "visitSomething" and there are basically two kinds
# of "visit" functions: Functions that produce statements, such as
# visitAssignment or visitForRange do not return results and generate
# code as a side effect. Functions that compile expressions, such as
# visitBinOp or visitFunctionCall return Value objects representing the
# type and the compiled expression. These *may* also output complete
# "preparatory" statements as a side effect.
#
# function_signatures: a compile-time dictionary of name -> signature,
# where signature is [required, optional, keyword, restparam, dictparam, ftype]
# where required is [rtype0, rname0, rtype1, rname1, ...], optional is
# [otype0, oname0, odefault0, otype1, oname1, odefault1, ...], keyword is 
# [ktype0, kname0, kdefault0, ktype1, kname1, kdefault1, ...],
# rest is the rest parameter name, keyword_dict is the dictionary name.
# (see class Function in ast.srp)
# When calling, the parameter list is:
#     (rtype0, rtype1, ..., any_array, kdict, otype0, otype1, ...],
# where any_array is only present if rest is true, and it is an new array
# containing extra parameters as Any, kdict is a dictionary of all keyword
# parameters. In these parameters, name0 has ktype0, name1 has ktype1, etc.,
# and any other keyword parameters (if keyword_dict is true) have type Any.


require "src/backend/visitor.srp"
require "src/frontend/ast.srp"

function_corrections = {
    "main": "main__",
    "str": "force_str",
    "int": "force_int" }


// destination parameter values for add_line
FOR_CPP = 'cpp'
FOR_H = 'h'
FOR_MAIN = 'main'
FOR_CODE = 'code'

// do we need this?

//CPP_TYPE_TO_TYPE_CODE = {
//    "int": "Any_type::INT",
//    "double": "Any_type::REAL",
//    "bool": "Any_type::BOOL",
//    "Any": "Any_type::NIL",  // means "Any"
//    "array": "Any_type::ARRAY",
//    "dict": "Any_type::DICT",
//    "symbol": "Any_type::SYMBOL"
//    }
//

TYPE_TO_TYPE_CODE = {
    'int': "Any_type::INT",
    'real': "Any_type::REAL",
    'bool': "Any_type::BOOL",
    'any': "Any_type::ANY",
    'array': "Any_type::ARRAY",
    'dict': "Any_type::DICT",
    'symbol': "Any_type::SYMBOL"
}


TYPE_TO_CPP_TYPE = {
    'int': "int ",
    'real': "double ",
    'bool': "bool ",
    'any': "Any ",
    'array': "Array *",
    'dict': "Dict *" }

// this is a bit of a hack, but "types" in global_variables get
// various strings, e.g. some representing string constants, so
// we check for both symbol and string versions of type names:
NON_PTR_TYPES = ["int", "real", "bool"]

def is_ptr_type(type):
    type not in NON_PTR_TYPES


NON_HEAP_TYPES = ['int', 'real', 'bool']

COMPARE_BIN_OPS = ["==", "!=", "<", "<=", ">", ">="]

CONDITIONAL_BIN_OPS = ["or", "and"]


class Type:
    var typ   // the type of the value
    var string_const  // if type is literal string, this is the literal
    var parameter  // parameters are "protected" and may be referenced
    // differently from ordinary locals that are on_heap
    
    def init(typ_, optional string_const_):
        if isstring(typ_):
            typ_ = intern(typ_)
        typ = 'any' if typ_ == 'var' else typ_
        string_const = string_const_
        assert(issymbol(typ))
        
    def to_str():
        var scstr = (" lit " + repr(string_const)) if string_const else ""
        "<Type: " + repr(typ) + scstr + ">"

    def is_string_type(): typ == 'string'

    def type_code(): TYPE_TO_TYPE_CODE[typ]

    # note: c_type ends in space or "*"
    def c_type(): TYPE_TO_CPP_TYPE[typ]

    def not_an_any(): typ != 'any'

    def not_on_heap(): typ in NON_HEAP_TYPES

    def on_heap(): typ not in NON_HEAP_TYPES

    def coerce_any(any_name):
        if not_an_any():
            return "as_" + str(typ) + "(" + any_name + ")"
        else:
            return any_name


STRING = Type('string')
INT = Type('int')
REAL = Type('real')
ANY = Type('any')
ARRAY = Type('array')
DICT = Type('dict')
BOOL = Type('bool')
NIL = Type('nil')

require "src/backend/primitives.srp"

class Value:
    var cpp   // the code that delivers the value
    var typ   // the Type description

    def init(type_, cpp_):
        assert(isinstance(type_, Type))
        typ = type_
        cpp = cpp_
        print "Value.init:", this

    def to_str():
        "<Value " + repr(cpp) + " typ " + str(typ) + ">"

    def is_string_type(): typ.is_string_typ()

    def type_code(): typ.type_code()

    def not_an_any(): typ.not_an_any()

    def cpp_to_any():
        ("Any{" + cpp + "}") if not_an_any() else cpp

    def is_an_int_constant(s):
        for c at i in s:
            if not isdigit(c) and not (c == "-" and i == 0):
                return false
        return true

    def to_type(totyp):
        display "to_type", this, totyp
        if typ.typ == totyp.typ:
            return cpp
        elif totyp.typ == 'any':
            return cpp_to_any()
        elif typ.typ == 'any':
            return totyp.coerce_any(cpp)
        elif typ.typ == 'int' and totyp.typ == 'real':
            if is_an_int_constant(cpp):
                return cpp + ".0"
            else:
                return "((double) (" + cpp + "))"
        else:
            print "Type conversion error: value", this, "to", totyp
            exit(1)


class CodegenVisitor(ASTVisitor):
    var output_folder  // path to output (C++) files
    var cpp_lines
    var header_lines
    var main_lines
    var main_includes
    var code_lines  // to be added to either cpp_lines or main_lines
    var function_signatures
    // locals will contain dictionary from name->type. Code will be
    // generated from this.  Note that locals can be int or real.
    // Even though not special code is needed for these, we put them
    // in the dictionary because they can take priority over globals
    // or class instance variables with the same name.
    var function_locals  // locals info for current function body
        // also, function_locals is for *_main, when not defining a function
    var header_includes
    var current_class
    var in_function  // true if in function (or method if current_class)
    var h_indent_level
    var cpp_indent_level
    var main_indent_level
    var code_indent_level
    var include_list
    var user_defined_classes
    var global_variables  // maps from global name to type, but a special
                // case is string constants value looks like string"foo"
    var hoisted_strings // maps literal to variable name
    var string_counter
    var temp_counters  // next available temp variable name of each type
    var last_statement_is_return  // do we need a final return?
    var class_config_code  // strings for <file>_main after CS_FUNCTION_ENTRY to
                // initialize class symbols, table and class_class
    var file_symbols  // list of symbols needed as static variables in file


    def init(_output_folder):
        super.init()
        output_folder = _output_folder
        reset()
        include_list = "#pragma once\n#include <runtime.h>\n"
        indentation = "    "
        global_variables = {}
        hoisted_strings = {}
        string_counter = 0
        temp_counters = {}
        function_locals = {}  // for main
        function_signatures = PRIMITIVES.copy()


    def reset():
        class_config_code = []  // code for symbols and other class implementation
        cpp_top_of_file = []  // place to insert declarations for file
        cpp_lines = [cpp_top_of_file]  // strings to be flattened
        header_lines = []  // strings to be flattened
        main_includes = []  // strings to be flattened
        main_lines = []
        code_lines = []  // strings to be appended to cpp_lines or main_lines
        h_indent_level = 0
        cpp_indent_level = 0
        main_indent_level = 0
        code_indent_level = 0
        file_symbols = []
        user_defined_classes = []


    def add_to_main(line, optional indent):
        add_line(FOR_MAIN, line, indent)

    def add_to_code(line, optional indent):
        add_line(FOR_CODE, line, indent)

    def add_to_cpp(line, optional indent):
        add_line(FOR_CPP, line, indent)

    def add_to_h(line, optional indent):
        add_line(FOR_H, line, indent)


    def add_line(dest, line, optional indent):
    # adds a C++ cpp line or .h line.
    # dest is FOR_CPP for .cpp and FOR_H for .h files.
    # If not in_function, FOR_CPP means append to main_lines,
    # otherwise, FOR_CPP means append to cpp_lines
    # To force append to main_lines, use FOR_MAIN.
    # "main" means global statements become statements in <file>_main().
        var lines
        var indent_level
        if dest == FOR_H:
            lines = header_lines
            indent_level = h_indent_level
        elif dest == FOR_MAIN:  // overrides in_function
            lines = main_lines
            indent_level = main_indent_level
        elif dest == FOR_CODE:
            lines = code_lines
            indent_level = code_indent_level
        elif dest == FOR_CPP:
            lines = cpp_lines
            indent_level = cpp_indent_level
//        elif in_function == 'main':  // overrides in_function
//            lines = main_lines
//            indent_level = cpp_indent_level
//        elif in_function:
//            lines = cpp_lines
//            indent_level = cpp_indent_level
        else:
            lines = main_lines
            indent_level = main_indent_level
            display "Hmm, not main or function", dest, line
        indent = indent or indent_level
        for i = 0 to indent:
            lines.append(indentation)
        lines.append(line)
        lines.append("\n")


#    def add_line(line, optional ctx = nil):
#        if ctx == nil:
#            ctx = context
#        for i = 0 to indent_levels[ctx]:
#            line = indentation + line
#        if ctx == CTX_SOURCE:
#            cpp_lines.append(line)
#        elif ctx == CTX_HEADER:
#            header_lines.append(line)
#        else:  // CTX_MAIN
#            main_lines.append(line)


    def begin_statement():
    # returns info that should be passed to end_statement when the
    # statement has finished compiling. This is used to "free"
    # the temporary variables that were used to execute the statement
        return temp_counters.copy()


    def end_statement(state):
    # restores state to where it was before the statement was compiled
        // state is just a copy of temp_counters
        temp_counters = state


    def allocate_temp(typ):
        display "allocate_temp", typ, typ.not_on_heap(), function_locals
        var count = temp_counters.get(typ, 0)
        var name = "temp_" + str(typ.typ) + "_" + str(count)
        temp_counters[typ.typ] = count + 1
        # need to create a new local variable for temporary?
        if not function_locals.has_key(name):
            function_locals[name] = typ
            if typ.not_on_heap():
                add_to_code(typ.c_type() + " " + name + ";")
        return name


    def assign_to_global(name, value):
        // if the global is declared as int, real, or bool, we can
        // set it directly after coercing the value:
        var gtype = global_variables[name]
        if gtype.not_an_any():
            if not value.not_an_any():
                value.cpp = "as_" + gtype + "("
            code_line = name + " = ("
        else:  // otherwise, use set_any_global():
            code_line = "set_any_global(&" + name + ", "
        add_to_code(code_line + value.cpp_to_any() + ");")


    def visitLiteral(literal):
        display "visitLiteral", literal.value, type(literal.value), isstring(literal.value), literal.value_type, type(literal.value_type)
        if literal.value_type == 'string':
            var text = literal.value
            var typ = Type('string', text)
            if not hoisted_strings.has_key(text):
                var var_name = "string_" + str(string_counter)
                string_counter = string_counter + 1
                hoisted_strings[text] = var_name
                global_variables[var_name] = typ
            return Value(typ, hoisted_strings[text])
        elif literal.value_type == 'symbol':
            print "ERROR: need to implement literal symbols"
            exit()
            // return "Symbol {\"" + subseq(str(literal.value), 1, -1) + "\"}"
            // in global_vars.{h,cpp}, make globals to hold pointer to symbols
            // When global vars are initiated, if there is already a symbol
            // stored in a global, you can avoid looking it up.
            // return the global name here.
        elif not isstring(literal.value):
            print "Internal Error: expecting literal.value to be string: ";
            print     repr(literal.value)
            exit(1)
        elif literal.value_type == 'int':
            typ = INT
            // modify digit string to be an explicit long long in C++, e.g., 4LL
            if isdigit(literal.value.last()):
                literal.value = literal.value + "LL"
        elif literal.value_type == 'real':
            typ = REAL
        elif literal.value_type == 'bool':
            typ = BOOL
        elif literal.value == "nil":
            typ = NIL
        else:
            print "Error:", literal.value, "is not recognized, typ ", repr(typ)
            error("visitLiteral problem")
            typ = ANY
        return Value(typ, literal.value)


    def visitIdentifier(identifier):
        // local variables shadow member variables
        display "visitIdentifier", identifier.name, function_locals,
        display         function_locals.get(identifier.name, "not here")
        if function_locals.has_key(identifier.name):
            var ltype = function_locals[identifier.name]
            display "  visitIdentifier2", ltype.parameter
            return Value(ltype, identifier.cpp_for_local(ltype))
        # needs to encapsulate all inherited member variables:
        # not sure why we need "get_" instead of just name
        if current_class and identifier.name in current_class.member_variables:
            # also need parser to encode member_variables as
            # dict from name to type so we can return correct type:
            return Value(ANY, "get_" + identifier.name + "()")
        // not a declared local or instance variable, so must be a global
        var ident = identifier.cpp_for_global()
        // if global is implicitly declared, insert into global_variables
        if not global_variables.has_key(ident):
            display "** visitIdentifier", identifier
            // if identifier.cpp_for_global() == "csg_b":
            //     print "=================================================="
            //     stacktrace()
            //     print "=================================================="
            global_variables[ident] = ANY
        display "calling Value", ident, repr(global_variables[ident])
        return Value(global_variables[ident], ident)


    def visitBoolOp(bool_op):
        return Value(BOOL, bool_op.left.accept(this).cpp + " " + bool_op.op +
                             " " + bool_op.right.accept(this).cpp)


    def visitBinOp(bin_op):
        var func = nil
        var typ = REAL
        var left = bin_op.left.accept(this)
        var right = bin_op.right.accept(this)
        var left_cpp = left.cpp
        var right_cpp = right.cpp

        if bin_op.op == "**":
            func = "pow"
        if bin_op.op == "is":
            func = "is_equal"
            typ = BOOL
        if func:
            return Value(typ, func + "(" + left.cpp + ", " + right.cpp + ")")
        # this is probably wrong. It assumes int if left and right are int,
        # and real otherwise (also, real for "/" operator)
        if (left.typ == INT and right.typ == INT and bin_op.op != "/"):
            typ = INT
        if bin_op.op in COMPARE_BIN_OPS:
            typ = BOOL
        // or and and have the type of the first or last non-nil element
        // which means:
        elif bin_op.op == "or":
            // for or:
            //    if first type is not a pointer, the first type
            //    if first and second types are equal, the first type
            //    if first and second types are not equal, Any
            if left.typ.not_on_heap():
                print "first arg to or is always true:", left_cpp, "or", right_cpp
                return left
            elif left.typ.typ == right.typ.typ:
                typ = left.typ
            else:
                typ = ANY
                left_cpp = left.cpp_to_any()
                right_cpp = right.cpp_to_any()
        elif bin_op.op == "and":
            // for and:
            //    if first type is not a poiner, the second type
            //    if first and second types are equal, the first type
            //    if first and second types are not equal, Any
            if left.typ.not_on_heap():
                print "first arg to and is always true:", left_cpp, "or",
                print     right_cpp
                return right
            elif left.typ.typ == right.typ.typ:
                typ = left.typ
            else:
                typ = ANY
                left_cpp = left.cpp_to_any()
                right_cpp = right.cpp_to_any()
        return Value(typ, "(" + left_cpp + ") " + bin_op.op +
                          " (" + right_cpp + ")")


    def visitUnaryOp(unary_op):
        var typ = REAL
        var operand = unary_op.operand.accept(this)
        var cpp = operand.cpp
        if unary_op.op == "not":
            unary_op.op = "!"
            cpp = "to_bool(" + cpp + ")"
            typ = BOOL
        # this is probably wrong. It assumes int if operand is int,
        elif operand.typ == 'int':
            typ = INT
        return Value(typ, unary_op.op + "(" + cpp + ")")


    def visitArray(array_node):        # array literal
        var temp = allocate_temp(ARRAY)
        display "visitArray", temp
        add_to_code("LSET(SL_" + temp + ", Any {new Array(" +
                   str(len(array_node.elements)) + ", nil)});")
        for element at i in array_node.elements:
            add_to_code("L." + temp + "->set(" + str(i) + ", " +
                       element.accept(this).cpp + ");")
        return Value(ARRAY, "L." + temp)


    def visitDictionary(dictionary_node):
        var temp = allocate_temp(DICT)
        add_to_code("LSET(SL_" + temp + ", Any {new Dict()});")
        for pair at i in dictionary.pairs:
            add_to_code("L." + temp + "->set(" + pair[0].accept(this).cpp +
                       ", " + pair[1].accept(this).cpp + ");")
        return Value(DICT, "L." + temp)


    def visitArgumentList(arg_list, fcall):
    # this is "special" because it returns a string rather than Value
        var sig
        
        var kwargs = arg_list.kwargs
        var code_str = ""
        var need_comma = false
        if arg_list.dispatch == 'dynamic':
            for i = 0 to len(arg_list.args):
                add_to_code("PPARMS.append(" +
                            arg_list.args[i].accept(this).cpp_to_any() + ");")
                return
        else:  // regular call - check if we need coercions
            sig = function_signatures[fcall.name]
            var requireds = sig[0] or []
            var n_reqs = idiv(len(requireds), 2)
            if len(arg_list.args) < n_reqs:
                print "not enough actual parameters for", fcall.name
                return false
            for i = 0 to len(requireds) by 2:
                if need_comma:
                    code_str = code_str + ", "
                need_comma = true
                var value = arg_list.args[idiv(i, 2)].accept(this)
                code_str = code_str + value.to_type(requireds[i])
            var optionals = sig[1] or []
            var n_opts = idiv(len(optionals), 3)
            if len(arg_list.args) > n_reqs + n_opts and not sig[3]:
                print "too many actual parameters for", fcall.name
                return false
            // fill in optional parameters or default values
            for i = 0 to n_opts:
                var acti = i + n_reqs  // index of actual
                if need_comma:
                    code_str = code_str + ", "
                need_comma = true

                // find the value to pass as actual argument
                if acti < len(arg_list.args):  // pass actual value to optional
                    value = arg_list.args[acti].accept(this)
                else:  // pass default value
                    value = optionals[i * 3 + 2].accept(this)

                // coerce the actual to the formal type if necessary
                display "coerce actual", repr(value.typ.typ), 
                display      repr(optionals[i * 3])
                code_str = code_str + value.to_type(Type(optionals[i * 3]))
        // sig[3] is restparam
        if sig and sig[3] and len(arg_list) > n_reqs + n_opts
            var n_rest = len(arg_list) - (n_reqs + n_opts)
            var temp = allocate_temp(ARRAY)
            add_to_code("LSET(SL_" + temp + ", Any{new Array(" + str(n_rest) +
                       ", nil)});")
            for i = n_reqs + n_opts to len(arg_list):
                add_to_code("L." + temp + "->set(" + str(i) + ", " +
                           arg_list[i].accept(this).cpp_to_any() + ");")
            if need_comma:
                code_str = code_str + ", "
            need_comma = true
            code_str = code_str + "L." + temp


        ## THIS KWORD HANDLING IS NOT COMPLETE
        if arg_list.dispatch == 'dynamic' or len(kwargs.keys()) > 0:
            if len(kwargs.keys()) == 0:
                code_str = code_str + ", empty_dict"
            else:
                code_str = code_str + ", Dict {"
                for i = 0 to len(kwargs.keys()):
                    key = kwargs.keys()[i]
                    code_str = code_str + "{" + key.accept(this).cpp + ", " +
                               kwargs[key].accept(this).cpp + "}"
                    if i < len(kwargs) - 1:
                        code_str = code_str + ", "
                code_str = code_str + "}"
        return code_str


    def visitFunctionCall(fcall):
        if fcall.name in user_defined_classes:
            return visitConstructor(fcall)
        if fcall.name in function_corrections.keys():
            fcall.name = function_corrections[fcall.name]
        var code_str
        var args = fcall.parameters.args
        if fcall.name == "print" or fcall.name == "display":
            code_str = "std::cout << "
            if len(fcall.parameters.kwargs) != 0:
                print "Error: print function does not take keyword arguments"
                exit(1)
            var need_shift = false
            for arg at i in args:
                if need_shift:
                    code_str = code_str + " << "
                need_shift = true
                if isinstance(arg, Literal) and arg.value_type == 'string':
                    if arg.value == "\"\\n\"" and i == len(args) - 1:
                        code_str = code_str + "std::endl"
                    else:
                        display "$$$print", repr(arg.value), repr(arg.value_type)
                        code_str = code_str + arg.value
                else:
                    code_str = code_str + "(" + args[i].accept(this).cpp + ")"
        elif fcall.name == "exit":
            code_str = "exit(0)"
        elif fcall.name == "funcall":
            code_str = "apply(" + fcall.parameters.args[0].accept(this)
            code_str = code_str + ", *(new Array {"
            for i = 1 to len(args):
                code_str = code_str + args[i].accept(this).cpp
                if i < len(args) - 1
                    code_str = code_str + ", "
            code_str = code_str + "}))"
        elif fcall.name == "send":
            code_str = "sendapply(" +
                       fcall.parameters.args[0].accept(this).cpp +
                       ", " + fcall.parameters.args[1].accept(this).cpp +
                       ", *(new Array {"
            for i = 2 to len(args):
                code_str = code_str + args[i].accept(this).cpp
                if i < len(args) - 1
                    code_str = code_str + ", "
            code_str = code_str + "}))"
        elif fcall.name == "abs":
            if len(args) != 1:
                return false
            var param = args[0].accept(this)
            if param.typ.typ != 'real' and param.typ.typ != 'int' and
               param.typ.typ != 'any':
                return false
            return Value(param.typ, "abs(" + param.cpp + ")")
        elif fcall.name == "len":
            if len(args) != 1:
                return false
            param = args[0].accept(this)
            if param.typ.typ != 'array' and param.typ.typ != 'string' and
               param.typ.typ != 'any':
                return false
            return Value(INT, "len(" + param.cpp + ")")
        else:
            var sig = function_signatures.get(fcall.name, nil)
            if not sig:
                print "No known signature for", fcall.name
                exit(1)
            // parameters has type ArgumentList:
            return Value(Type(sig[5]), fcall.name + "(" +
                         fcall.parameters.accept(this, fcall) + ")")
        return Value(ANY, code_str)
        

    def visitConstructor(constr):
        return Value(Type(intern(constr.name)),
                     "new " + constr.name + "_class(" +
                     constr.parameters.accept(this, constr) + ")")


    def visitMethodCall(mcall):
        var code_str = mcall.object.accept(this).cpp
        # Special case for append method - call it directly
        if mcall.method_name == "append":
            code_str = code_str + ".append("
            # Append should have exactly one argument
            if len(mcall.parameters.args) == 1:
                code_str = code_str + mcall.parameters.args[0].accept(this).cpp
            code_str = code_str + ")"
        else:
            # General case using .call()
            add_to_code("PPARMS.clear();")
            add_to_code("KPARMS.clear();")
            mcall.parameters.dispatch = 'dynamic'
            var p = mcall.parameters.accept(this, nil)
            code_str = code_str + ".call(css_" + mcall.method_name + ")"
        return Value(ANY, code_str)


    def visitGetAttribute(get_attribute):
    # this needs work -- why do we need to call get_<attribute>?
        return get_attribute.object.accept(this).cpp + ".call(\"get_" +
               get_attribute.attribute + "\", empty_array, empty_dict)"


    def visitIndex(index):
        return Value(ANY, index.object.accept(this).cpp + "[" +
                          index.index.accept(this).to_type(INT) + "]")


    def visitAssignment(assign):
        print "IN visitAssignment", assign.identifier, assign.expression
        var ident = assign.identifier
        var value
        if isinstance(ident, GetAttribute):
            # does this handle a.b.c[x].h = ?
            code_line = ident.accept(this).cpp
            # this all seems wrong - at least not fast when types are known
#             code_line = code_line + ".call(\"set_" +
#                 ident.attribute + "\", Array {"
#             assign.expression.accept(this)
#            add_line(curr_code_line + "}, empty_dict);")
#            curr_code_line = ""
            return

        if isinstance(ident, Index):
            // ident.object must be evaluated to an Array
            // then we just invoke ->set(index, value), where index must be INT
            // and value is anything (set is polymorphic C++ method)
            var ar = ident.object.accept(this).to_type(ARRAY)
            display "in assign", ar
            var i = ident.index.accept(this).to_type(INT)
            add_to_code(ar + "->set(" + i + ", " +
                       assign.expression.accept(this).cpp + ");")


            # does this handle a[2].b.c[x].h = ?
# this all seems wrong - at least not fast when types are known
#            index_obj = ident
#            index_obj.object.accept(this)
#            curr_code_line = curr_code_line + ".set(to_int("
#            index_obj.index.accept(this)
#            curr_code_line = curr_code_line + "), "
#            assign.expression.accept(this)
#            add_line(curr_code_line + ");")
#            curr_code_line = ""
            return

        var name = ident.name
        if current_class and isinstance(ident, Identifier) and
           name in current_class.member_variables:
            code_line = "set_" + name + "(" + 
                        assign.expression.accept(this).cpp_to_any() + ");"
            add_to_code(code_line)
            return

        # not member, so must be global or local

        value = assign.expression.accept(this)
        // see if it is local
        if in_function and function_locals.has_key(name):  // it's local
            # non-ptr can just be directly assigned
            if function_locals[name].not_an_any():
                
                if not value.not_an_any():
                    value.cpp = "as_" + function_locals[name] + "(" +
                                value.cpp + ")"
                add_to_code(name + " = " +
                           value.to_type(Type(function_locals[name]))) + ";"
            else:
                add_to_code("LSET(SL_" + name + ", " + value.cpp + ");")
        else: // it's global
            if isinstance(ident, Identifier) and current_class == nil:
               global_variables[ident.cpp_for_global()] = ANY
            assign_to_global(ident.cpp_for_global(), value)


    def visitStandaloneExpression(standalone_expression):
#        in_function = 'main'
#        display "visitStandaloneExpression sets", in_function
        var code_line = standalone_expression.expression.accept(this)
        add_to_code(code_line.cpp + ";")
#        in_function = false
#        display "visitStandaloneExpression exits, sets", in_function


    def visitDeclaration(declaration):
        // add_line(declaration.declared_type + " " +
        //          declaration.identifier.value + ";")
        display "** visitDeclaration", declaration.declared_type,
        display         declaration.identifier.name
        global_variables[declaration.identifier.cpp_for_global()] =
                Type(declaration.declared_type)


    def visitDeclarationNAssignment(d_and_a):
        display "visitDeclAssign", d_and_a.identifier.name, d_and_a.declared_type
        var name = d_and_a.identifier.name
        var code_line
        if in_function:
            if function_locals.has_key(name)
                print "ERROR: local", d_and_a.identifier.name,
                print     "already declared."
                exit(1);
            dtype = Type(d_and_a.declared_type)
            function_locals[name] = dtype
            if d_and_a.declared_type in ['int', 'real', 'bool']:
                code_line = dtype.c_type() + name + " = ("
            else:
                code_line = "LSET(SL_" + name + ", "
            add_to_code(code_line +
                       d_and_a.expression.accept(this).to_type(dtype) + ");")
        else:  // this is a global declaration
            var ident = d_and_a.identifier
            display "** visitDeclarationNAssignment", d_and_a.declared_type,
            display         ident.name, type(d_and_a.declared_type)
            global_variables[ident.cpp_for_global()] = 
                    Type(d_and_a.declared_type)
            display "   ", global_variables[ident.cpp_for_global()],
            display     ident.cpp_for_global()

            assign_to_global(ident.cpp_for_global(),
                             d_and_a.expression.accept(this))


    def visitReturnStatement(return_statement):
        add_to_code("CS_FUNCTION_EXIT(" +
                   return_statement.expression.accept(this).cpp + ");")
        if code_indent_level == 1:
            last_statement_is_return = true
        // otherwise, we're returning from inside a block and we cannot assume
        // a return statement will be reached


    def visitBlock(block):
        // top of function must place local declarations after "{" so we do
        // not want to output the "{" here. Other blocks need a "{" at start.
        if block.needs_open_brace:
            add_to_code("{")
        code_indent_level = code_indent_level + 1
        for statement in block.statements:
            var state = begin_statement()
            last_statement_is_return = false;
            statement.accept(this)
            end_statement(state)
        code_indent_level = code_indent_level - 1
        add_to_code("}")


    def visitIf(if_statement):
        var cond = if_statement.condition.accept(this)
        display "visitIf", cond
        add_to_code("if (" + cond.to_type(BOOL) + ") {")
        if_statement.block.needs_open_brace = false  // we do not want it
        if_statement.block.accept(this)
        if if_statement.else_block is not nil:
            add_line("else")
            if_statement.else_block.accept(this)


    def visitWhile(while_stmt):
        var code_line = "while (to_bool(" + while_stmt.condition.accept(this)
        add_to_code(code_line + "))")
        while_stmt.block.accept(this)


    def visitForRange(stmt):
        display "visitForRange", stmt.start, stmt.identifier
        if not function_locals.has_key(stmt.identifier):
            function_locals[stmt.identifier] = INT
        var code_line = "for (csl_" + stmt.identifier + " = " +
                        stmt.start.accept(this).cpp + "; csl_" +
                        stmt.identifier + " < " + stmt.end.accept(this).cpp +
                        "; csl_" + stmt.identifier + " += " +
                        stmt.by_amount.accept(this).cpp
        add_to_code(code_line + ")")
        stmt.block.accept(this)


    def visitForEach(stmt):
        var code_line = "for (auto " + stmt.identifier.name + " : " + 
                        stmt.iterable.accept(this) + ")"
        add_to_code(code_line)
        stmt.block.accept(this)


    def visitFunction(function):
        assert(not in_function)
        in_function = true
        display "visitFunction sets", in_function, function.name

        var main_function_locals = function_locals
        function_locals = {}  // new name space inside function

        var main_temp_counters = temp_counters
        temp_counters = {}  // new name space inside function

        if function.name == "main":
            function.name = "main__"

        # collect arguments within the parentheses
        display "visitFunction", function.name

        var sig = function.signature
        var code_line
        var c_type
        var is_init_function = false
        if current_class and (function.name == "init" or
                              function.name == current_class.name):
            code_line = current_class.name + "_class("
            c_type = ""
            is_init_function = true
        else:
            code_line = function.name + "("
            c_type = Type(sig[5]).c_type()
        function_signatures[function.name] = sig
        var requireds = sig[0] or []  # requireds
        var n_reqs = idiv(len(requireds), 2)
        display "visitFunction", sig, requireds, n_reqs
        var need_comma = false
        // var ptr_type_params = []
        for i = 0 to len(requireds) by 2:
            if need_comma:
                code_line = code_line + ", "
            need_comma = true
            var ptype = Type(requireds[i])
            ptype.parameter = true  // this is a protected parameter
            requireds[i] = ptype  // replace type spec with a Type instance
            var pname = requireds[i + 1]
            code_line = code_line + ptype.c_type() + "csl_" + pname
            function_locals[pname] = ptype
            // if ptype.on_heap():
            //     ptr_type_params.append(pname)
        if sig[3]:
            if need_comma:
                code_line = code_line + ", "
            code_line = code_line + "ArrayPtr csl_" + sig[3]
            need_comma = true
        if sig[2] or sig[4]:
            if need_comma:
                code_line = code_line + ", "
            code_line = code_line + "DictPtr csl_" + sig[3]
            need_comma = true
        var optionals = sig[1] or []  # optionals
        var n_opts = idiv(len(optionals), 3)
        for i = 0 to len(optionals) by 3:
            if need_comma:
                code_line = code_line + ", "
            need_comma = true
            var otype = Type(optionals[i])
            var oname = optionals[i + 1]
            code_line = code_line + otype.c_type() + "csl_" + oname
            function_locals[oname] = otype
        code_line = code_line + ")"

        var dynamic_line = "Any dynamic_" + function.name + "()"

        add_to_h(c_type + code_line + ";")

        if current_class:
            add_to_code("\n" + c_type + current_class.name + "_class::" +
                                   code_line)
        else:
            add_to_code("\n" + c_type + code_line)

        var fld = []  // function local declarations
        add_to_code("{")
        function.block.needs_open_brace = false  // we do not want top-level
                               // function blocks to output "{" at the start
        code_lines.append(fld)

        if is_init_function:
            add_to_code("    set_class_ptr(" + current_class.name +
                       "_class_class);")

//        cpp_indent_level = cpp_indent_level + 1
        // move parameters to "protected" locals
        // for pname in ptr_type_params:
        //    add_to_code("LSET(SL_" + pname + ", csl_" + pname + ");")

        # make corrections to the block
        var last_statement = function.block.statements.last()
        if not isinstance(last_statement, ReturnStatement):
            if isinstance(last_statement, StandaloneExpression):
                function.block.statements[len(function.block.statements) - 1] =
                        ReturnStatement(last_statement.expression)
            else:
                function.block.statements.append(
                        ReturnStatement(Identifier("nil")))
        display "before accept block", function_locals
        function.block.accept(this)

        generate_locals_and_entry(fld)

        # Now construct the stub for dynamic calls:

        if current_class:
            nil
        else:
            # function is global
            add_to_h(dynamic_line + ";")
            add_to_code("\n" + dynamic_line + "\n{")
            var dfld = []  // dynamic function local declarations
            code_lines.append(dfld)

            code_indent_level = code_indent_level + 1
            display "Constructing return", sig[5]
            var call = "CS_FUNCTION_EXIT(" + ("" if sig[5] == "var"
                                              else "Any{")
            call = call + function.name + "("
            sig = function.signature
            if not sig:
                print "ERROR: No signature for", function.name
                exit(1)

            // coerce required variables and add to actual parameters
            need_comma = false
            for i = 0 to len(requireds) by 2:
                var rtype = requireds[i]  // now instance of Type
                var rname = requireds[i + 1]
                display "In req loop", i, n_reqs, rtype, rname, rtype.not_on_heap()
                if need_comma:
                    call = call + ", "
                need_comma = true
                if rtype.not_on_heap():
                    add_to_code(rtype.c_type() + "csl_" + rname + " = as_" +
                               str(rtype.typ) + "(PPARMS[" + str(idiv(i, 2)) +
                               "]);")
                    call = call + "csl_" + rname
                else:
                    call = call + "PPARMS[" + str(idiv(i, 2)) + "]"
            var rest_arg = sig[3]
            add_to_code("int rest_offset = " + str(n_reqs + n_opts) + ";")
            if rest_arg:
                # Optionals: first, see if we have more args than positional
                # parameters (formal requireds + formal optionals). If so,
                # and if there is a rest parameter, construct it by copying
                # remaining parameters; otherwise construct empty array.
                # Then, each optional parameter is a conditional expression:
                # if available, use args[i]; otherwise, use the default value.
                add_to_code("if (rest_offset < PPARMS.len()) {")
                add_to_code("    L.rest = subseq(&args, rest_offset);")
                add_to_code("} else {")
                add_to_code("    L.rest = Array();")
                add_to_code("}")
                function_locals["rest"] = ARRAY
            else:  // must not have too many args
                add_to_code("assert(PPARMS.len() <= rest_offset);")

            # Now pass in remaining args as optional values or if there
            # are no actuals, pass in the default values.
            for i = 0 to len(optionals) by 3:
                otype = Type(optionals[i])
                oname = optionals[i + 1]
                var odefault = optionals[i + 2]
                var argi = str(n_reqs + idiv(i, 3))
                var oexpr = odefault.accept(this)
                oexpr = oexpr.to_type(otype)
                var arg = "PPARMS[" + argi + "]"
                var local_var
                display "optional actual loop", otype, oname, odefault
                function_locals[oname] = otype
                if otype.on_heap():
                    add_to_code("LSET(SL_" + oname + " = (PPARMS.len() > " +
                               argi + " ? " + arg + " : " + oexpr + ");")
                    local_var = "L." + oname
                else:
                    arg = otype.coerce_any(arg)
                    add_to_code(otype.c_type() + "csl_" + oname + 
                               " = (PPARMS.len() > " + argi +
                               " ? " + arg + " : " + oexpr + ");")
                    local_var = "csl_" + oname
                # now local_var is the name of the local variable for this
                # optional. We need to assign a value to it:
                if need_comma:
                    call = call + ", "
                need_comma = true
                call = call + local_var

            generate_locals_and_entry(dfld, 'dynamic')

            if rest_arg:
                if need_comma:
                    call = call + ", "
                need_comma = true
                call = call + "L.rest"
            call = call + ("));" if sig[5] == "var" else ")});")
            add_to_code(call, 1)
            code_indent_level = 0
            add_to_code("}")
            add_line(FOR_MAIN, "intern(\"" + function.name +
                               "\")->set_slot(1, (Any *) &dynamic_" + 
                               function.name + ");")
        print "AFTER FUNCTION", function_locals
        in_function = false
        display "visitFunction sets", in_function
        function_locals = main_function_locals  // restore
        temp_counters = main_temp_counters  // restore



    def visitClass(class_):
        current_class = class_
        assert(not in_function)
        user_defined_classes.append(class_.name)
        var class_ptr = class_.name + "_class"
        var get_set_list = []
        // add_to_h("\nextern Cs_class * " + class_ptr + ";")
        add_to_h("class " + class_.name + "_class : public Obj {")
        add_to_h("public:")
        h_indent_level = 1
        add_to_h("Any more_slots[" + 
                               str(len(class_.member_variables)) + "];")
        // add_to_h(class_.name + "() : Obj {" + class_ptr + "} {}")
        var csymbols = []  // symbols needed for class configuration
        for variable at index in class_.member_variables:
            var variable_str = variable
            var getter = "get_" + variable_str
            var setter = "set_" + variable_str
            csymbols.append(getter);
            csymbols.append(setter);
            file_symbols.append("css_" + getter);
            file_symbols.append("css_" + setter);

            
            add_to_h("Any " + getter + "() {")
            # since slot 0 is for class pointer:
            add_to_h("return slots[" + str(index + 1) + "];", 2)
            add_to_h("}")
            add_to_h("Any " + setter + "(Any value) {")
            add_to_h("set_slot(" + str(index + 1) + ", value);",
                     2)
            add_to_h("return nil;", 2)
            add_to_h("}")

            get_set_list.append([getter, 0])
            get_set_list.append([setter, 1])

        csymbols.append(class_.name)

        h_indent_level = 1;
        for function in class_.member_functions:
            display "METHOD DEFINITION for", function.name
            var name = function.name
            if name == "init":
                name = class_.name
                print "Changing init to "; class_.name
            function.accept(this)
//            var sig = function.signature
//            var req_args = nil
//            if isnull(sig[1]) and isnull(sig[2]) and
//               isnull(sig[3]) and isnull(sig[4]):
//                req_args = sig[0]
//            get_set_list.append([name, req_args])
            if name == class_.name:  // note name is changed above
                function_signatures[class_.name] = function.signature

//                # This only supports init with required parameters
//                var args = function.signature[0]
//                var num_args = len(args) if args else 0
//                var enclosed = ""
//
//                var code_line = class_.name + "("
//                for i = 0 to num_args:
//                    # Change this once type inference exists:
//                    code_line = code_line + "Any " + args[i]
//                    enclosed = enclosed + args[i]
//                    if i < num_args - 1:
//                        code_line = code_line + ", "
//                        enclosed = enclosed + ", "
//                code_line = code_line + ") : Obj {" + class_ptr + "} {"
//                add_to_h(code_line)
//                add_to_h("init(" + enclosed + ");", 2)
//                add_to_h("}")
            else:
                csymbols.append(name)
                file_symbols.append("css_" + name)

        for sym in csymbols:
            class_config_code.append("    css_" + sym + " = intern(\"" + sym +
                                     "\");\n")
        class_config_code.append("    " + class_.name + "_table.clear();\n")
        for sym in csymbols:
            if sym != class_.name:  // skip constructor, which is not a method
                class_config_code.append("    " + class_.name +
                        "_table.emplace(css_" + sym + ", " + class_.name +
                        "_" + sym + ");\n")
        var bitmap = "1"  // first slot is class pointer
        for mv in class_.member_variables:  // map out other pointer slots
            bitmap = ("1" if true else "0") + bitmap
        class_config_code.append("    " + class_.name +
                "_class_class = new Cs_class(css_" + class_.name +
                ", 1, 0b" + bitmap + ", &" + class_.name + "_table);\n")

        h_indent_level = 0
        add_to_h("};")

        var signature
        for get_set in get_set_list:
            signature = "Any " + class_.name + "_" + get_set[0] + "(Obj *self)"
            add_to_h(signature + ";")
            add_to_code("\n" + signature + "\n{")
            code_indent_level = 1
            add_to_code("check_dispatch(\"" + get_set[0] + "\", " +
                        str(get_set[1]) + ");")
            var parms = "" if get_set[1] == 0 else "PPARMS[0]"
            add_to_code("return reinterpret_cast<" + class_.name +
                        "_class *>(self)->" + get_set[0] + "(" + parms + ");")
            code_indent_level = 0
            add_to_code("}")
                

        # Define global functions for each class member function
        for function in class_.member_functions:
            var is_init_function = (function.name == "init")
            if is_init_function: // init function becomes constructor
                signature = "Any dynamic_" + class_.name + "()"
            else:
                signature = "Any " + class_.name + "_" + function.name +
                            "(Obj *self)"

            print "Member of "; class_.name; ": "; signature
            
            add_to_h(signature + ";")
            add_to_code("\n" + signature + "\n{")
            code_indent_level = 1
            // check parameter count maximum positional args:
            var sig = function.signature
            var n_req = idiv(len(sig[0]), 2) if sig[0] else 0
            var n_opt = idiv(len(sig[1]), 3) if sig[1] else 0
            add_to_code("check_dispatch(\"" +
                        (class_.name if is_init_function else function.name) +
                        "\", " + str(n_req + n_opt) + ");")
            var dispatch_line
            if is_init_function:
                dispatch_line = "Any{" + class_.name + "("
            else:
                dispatch_line = "reinterpret_cast<" + class_.name +
                                "_class *>(self)->" + function.name + "("
            var need_comma = false
            for i = 0 to n_req:
                if need_comma:
                    dispatch_line = dispatch_line + ", "
                need_comma = true
                dispatch_line = dispatch_line + "PPARMS[" + str(i) + "]"
            for i = 0 to n_opt:
                if need_comma:
                    dispatch_line = dispatch_line + ", "
                need_comma = true
                dispatch_line = dispatch_line + "(" + str(n_req + i) +
                    " < PPARMS.len() ? PPARMS[" + str(n_req + i) +
                    "] : " + str(sig[1][i * 3 + 2]) + ")"
            if is_init_function:
                dispatch_line = dispatch_line + ")};"
            else:
                dispatch_line = dispatch_line + ");"
            add_to_code("return " + dispatch_line)
            code_indent_level = 0
            add_to_code("}")

        # Create the MemberTable that maps symbols to function pointers
        var table_name = "MemberTable " + class_.name + "_table"
        add_to_h("extern " + table_name + ";")
        add_to_code("\n" + table_name + ";")

//        code_indent_level = code_indent_level + 1
//        need_comma = false
//        var table_items = ""
//        for function in get_set_list:
//            if need_comma:
//                table_items = table_items + ",\n    "
//            need_comma = true
//            table_items = table_items + "{Symbol{\"" + function[0] + "\"}, " +
//                          class_.name + "_" + function[0] + "}"
//        for function in class_.member_functions:
//            if function.name != "init": // skip constructor, it's not callable
//                if need_comma:
//                    table_items = table_items + ",\n    "
//                need_comma = true
//                table_items = table_items + "{Symbol{\"" + function.name +
//                              "\"}, " + class_.name + "_" + function.name + "}"
//        add_to_code(table_items);
//        code_indent_level = 0
//        add_to_code("};")

        # NOTE: 0b0 should be changed once type inference is implemented and
        #       we have pointer types
        var cs_class_init = "{Symbol {\"" + class_.name + "\"}, " +
                            str(len(class_.member_variables)) + ", 0b0, &" +
                            class_.name + "_table};"
//        add_to_code("\nCs_class *" + class_ptr +
//                               " = new Cs_class " + cs_class_init)

        // Make constructor and coercion functions:
        var csclass = class_.name + "_class"
        add_to_h(csclass + " *" + class_.name + "() {")
        add_to_h("    return new " + csclass + "();\n}")
        var fsig = csclass + " *to_" + class_.name + "(Any x)"
        add_to_h(fsig + ";")
        add_to_cpp(fsig + "\n{\n    return reinterpret_cast<" + csclass +
                   " *>(x.heap_obj);\n}\n")
        fsig = csclass + " *as_" + class_.name + "(Any x)"
        add_to_h(fsig + ";")
        add_to_cpp(fsig + "\n{\n    check(is_" + class_.name + "(x));")
        add_to_cpp("    return to_" + class_.name + "(x);\n}\n")
        fsig = "bool is_" + class_.name + "(Any x)"
        add_to_h(fsig + ";\n")
        add_to_cpp(fsig + "\n{")
        add_to_cpp("    return is_obj(x) && to_obj(x)->isinstance(" +
                   csclass + "_class);\n}\n")

        current_class = nil


    def visitFile(file):
        add_to_h(include_list)
        for element in file.elements:
            if isinstance(element, Function) or isinstance(element, Class):
                assert(len(code_lines) == 0)
                code_indent_level = 0
                element.accept(this)
                cpp_lines = cpp_lines + code_lines
                code_lines.clear()
            else:
                in_function = 'main'
                display "in visitFile, set", in_function, element
                assert(len(code_lines) == 0)
                code_indent_level = 1
                element.accept(this)
                code_indent_level = 0
                in_function = false
                main_lines = main_lines + code_lines
                code_lines.clear()
                

#    def generate_main(filename, source_file, ast):
